p/%5Blang%5D/news/%5Bid%5D/page-e0ecc169116052d4.js\"],\"default\"]\n1f:I[10024,[\"902\",\"static/chunks/902-27772842be6816ea.js\",\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"1337\",\"static/chunks/1337-81d43bfacef9d960.js\",\"6812\",\"static/chunks/6812-40cdafdaa8a94ce7.js\",\"2556\",\"static/chunks/2556-4d7c9cf06d447398.js\",\"7976\",\"static/chunks/7976-4f9c77f2476a84cf.js\",\"7150\",\"static/chunks/7150-e5e713f21ff63792.js\",\"1782\",\"static/chunks/1782-d3ba7b56fa54830d.js\",\"9558\",\"static/chunks/9558-b084350b79199c0b.js\",\"8615\",\"static/chunks/8615-36f4ddf19f5530c3.js\",\"28\",\"static/chunks/28-3bc0b4a8bc2521b2.js\",\"5151\",\"static/chunks/5151-77a2eea8ff597dab.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-e0ecc169116052d4.js\"],\"ArticleActions\"]\n20:I[71824,[\"902\",\"static/ch"])</script><script>self.__next_f.push([1,"unks/902-27772842be6816ea.js\",\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"1337\",\"static/chunks/1337-81d43bfacef9d960.js\",\"6812\",\"static/chunks/6812-40cdafdaa8a94ce7.js\",\"2556\",\"static/chunks/2556-4d7c9cf06d447398.js\",\"7976\",\"static/chunks/7976-4f9c77f2476a84cf.js\",\"7150\",\"static/chunks/7150-e5e713f21ff63792.js\",\"1782\",\"static/chunks/1782-d3ba7b56fa54830d.js\",\"9558\",\"static/chunks/9558-b084350b79199c0b.js\",\"8615\",\"static/chunks/8615-36f4ddf19f5530c3.js\",\"28\",\"static/chunks/28-3bc0b4a8bc2521b2.js\",\"5151\",\"static/chunks/5151-77a2eea8ff597dab.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-e0ecc169116052d4.js\"],\"default\"]\n21:Ta8b,"])</script><script>self.__next_f.push([1,"\u003cp\u003e1月22日，蚂蚁数科与同方全球人寿签署“保险AI创新应用”合作协议。双方将以人工智能技术为核心，在保险全业务领域深化合作。此次合作标志着金融AI技术在保险业务场景的深度融合，旨在通过科技赋能重塑业务流程，提升运营效率与风控水平。\u003c/p\u003e\u003cp\u003e当前，AI技术已成为保险业高质量发展的重要引擎。从2025年中期业绩报告可见，头部险企纷纷将AI列为战略重点，围绕客户体验、产品体系和专业能力建设等，以技术驱动金融创新。艾瑞咨询预测，2025年中国保险业科技投入将突破670亿元，智能化转型进入加速期。而理赔环节的智能化是保险AI升级的重要一环。传统理赔模式下，大量成本沉淀于人工审核、单证传递与多方沟通等环节，成为效率提升的主要瓶颈。\u003c/p\u003e\u003cp\u003e针对以上痛点，蚂蚁数科与同方全球人寿共同研发的智能理赔系统，基于AI智能体与多模态大模型技术，实现材料防伪核验、智能分类、质量检测、上下文语义解析及缺件自动提示、结合保单责任自动审核等核心能力，该系统识别准确率超过99%，可大幅降低人工审核与沟通成本。测试数据显示，该系统将整体理赔效率提升近一倍，部分简易案件可实现从提交、审核到赔款到账的全流程一小时办结。该项目因其在客户体验与风险防控方面的突出表现，成功入选《金融时报》“金龙·金融力量”年度案例。\u003c/p\u003e\u003cp style=\"text-align:center\"\u003e\u003cimg src=\"https://upload.chinaz.com/2026/0122/6390470108497301019995552.png\" title=\"image.png\" alt=\"image.png\"/\u003e\u003c/p\u003e\u003cp style=\"text-align: center;\"\u003e图:蚂蚁数科副总裁孙磊（左）与同方全球人寿总经理朱庆国(右)签约保险AI创新应用\u003c/p\u003e\u003cp\u003e签约仪式上，同方全球人寿总经理朱庆国表示:“同方全球人寿与蚂蚁数科在智能理赔项目上的成功实践为进一步合作奠定了坚实的基础。我们期待与蚂蚁数科一起将创新的模式系统性地推广到更多业务领域，为客户提供更智能、更安心的保险服务。”\u003c/p\u003e\u003cp\u003e蚂蚁数科副总裁孙磊表示:“蚂蚁数科在金融AI领域已沉淀了完善的方法论与全栈技术解决方案。我们期待与同方全球人寿开展深度协同，通过技术共享与场景共创，共同打造保险业AI升级的行业范本，助力行业实现系统性提升。”\u003c/p\u003e\u003cp\u003e据悉，双方将进一步整合在保险业务场景理解与AI技术应用方面的双重优势，共同探索核保、营销、风控、客户服务等环节的整体智能化解决方案。\u003c/p\u003e"])</script><script>self.__next_f.push([1,"22:T9a1,"])</script><script>self.__next_f.push([1,"\u003cp\u003e\u003cspan style=\"text-indent: 2em;\"\u003e机器人技术正迎来从“工业自动化”向“物理 AI”跨越的关键时刻。据 IT之家 消息，微软研究院正式推出了一款名为 Rho-alpha 的全新 AI 模型。该模型致力于打破机器人对封闭、预设环境的依赖，使其能够在复杂多变且不可预测的现实场景中大显身手。\u003c/span\u003e\u003c/p\u003e\u003cp style=\"text-align:center\"\u003e\u003cimg src=\"https://upload.chinaz.com/2026/0122/6390469769217679479649122.png\" title=\"image.png\" alt=\"image.png\"/\u003e\u003c/p\u003e\u003cp\u003e作为微软“物理 AI”战略的核心成果，Rho-alpha 展现出了令人惊叹的交互能力。它能直接听懂人类的自然语言指令，并将其转化为精确的控制信号，引导机器人完成极其复杂的双手协同任务。这意味着，未来的机器人不再需要苦读晦涩的代码脚本，只需一句话，就能像人类一样理解并执行操作。\u003c/p\u003e\u003cp\u003e在感知层面，Rho-alpha 走得更远。它不仅继承了 Phi 家族优秀的视觉与语言处理基因，还\u003cspan class=\"spamTxt\"\u003e首次\u003c/span\u003e深度集成了\u003cstrong\u003e触觉感知\u003c/strong\u003e。当机器人抓取物体时，它能根据真实的触碰反馈实时微调动作力度和姿态。微软透露，未来还将加入力感知等更多模态，让机器人的操作精度达到新的高度。\u003c/p\u003e\u003cp\u003e为了让机器人更“聪明”、更合心意，Rho-alpha 引入了动态调整行为的适应机制。在实际运行中，如果机器人表现不佳，人类操作者可以通过3D 输入设备进行干预和纠正，而系统会将这些反馈实时吸收到学习过程中。通过 Azure 基础设施生成的海量仿真数据与真实世界演示数据的深度融合，Rho-alpha 正在加速进化，力求成为真正懂用户偏好的智能助手。\u003c/p\u003e\u003cp\u003e划重点:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e🗣️ \u003cstrong\u003e语言直控\u003c/strong\u003e:Rho-alpha 模型实现了自然语言与机器人控制信号的直接转换，支持复杂的双手协同操作，摆脱了传统预设脚本的束缚。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e🖐️ \u003cstrong\u003e触觉进化\u003c/strong\u003e:该模型在视觉基础上引入了触觉反馈机制，使机器人能根据实际触感实时调整行为，未来还将增加力感知模态以提升精度。\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e🔄 \u003cstrong\u003e持续学习\u003c/strong\u003e:系统支持人类实时干预与纠正，能通过3D 输入设备学习用户偏好，并结合仿真与真实数据不断优化其在非结构化环境中的表现。\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e"])</script><script>self.__next_f.push([1,"23:T1cf1,"])</script><script>self.__next_f.push([1,"\u003cp\u003e欢迎来到【AI日报】栏目!这里是你每天探索人工智能世界的指南，每天我们为你呈现AI领域的热点内容，聚焦开发者，助你洞悉技术趋势、了解创新AI产品应用。\u003c/p\u003e\u003cp\u003e新鲜AI产品\u003cstrong\u003e点击了解\u003c/strong\u003e：\u003ca href=\"https://app.aibase.com/zh\" style=\"color: rgb(255, 0, 0); text-decoration: underline;\"\u003e\u003cspan style=\"color: rgb(255, 0, 0);\"\u003ehttps://app.aibase.com/zh\u003c/span\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e1、淘宝天猫出重拳！AI 假图识别模型上线，让 P 图骗保无所遁形\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e淘宝天猫推出AI假图识别模型，有效遏制恶意售后行为，同时通过优化物流赔付机制和账号诚信体系，为商家挽回巨额损失，推动电商生态健康发展。\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://upload.chinaz.com/2026/0122/6390468789177345485696856.png\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🛒 AI假图识别模型上线，助力商家应对售后纠纷\u003c/p\u003e\u003cp\u003e💰 平台拦截异常退款行为，为商家挽回超40亿元损失\u003c/p\u003e\u003cp\u003e🚚 优化物流赔付机制，预计全年节约成本超10亿元\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e2、Inworld 推出全新 TTS-1.5：实时语音，延迟低，并支持多语言\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eInworld 推出全新 TTS-1.5：实时语音，延迟低，并支持多语言。TTS-1.5在技术上实现了低于250毫秒的实时延迟，同时提供多语言支持，价格仅为每分钟0.005美元，比市场上的同类产品便宜25倍。这一创新成果为游戏和虚拟现实领域的对话系统提供了新的可能性，用户对这一技术表现出浓厚兴趣并期待应用到自己的项目中。\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://upload.chinaz.com/2026/0122/6390467906440646422835374.png\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e📢 TTS-1.5模型推出，具备自然的语音合成和多语言支持。\u003c/p\u003e\u003cp\u003e💰 该模型每分钟费用约为0.005美元，比市场同类产品便宜25倍。\u003c/p\u003e\u003cp\u003e⚡ 实现低于250毫秒的实时延迟，为用户提供更真实的对话体验。\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e3、百川智能发布Baichuan-M3 Plus，医学幻觉率降至2.6%，树立医疗AI新标杆\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e百川智能推出的Baichuan-M3 Plus医疗大模型，在医学幻觉率方面取得重大突破，通过引入“六源循证范式”确保诊断建议的\u003cspan class=\"spamTxt\"\u003e权威\u003c/span\u003e性和准确性，为医疗AI的可信应用树立了新标杆。\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://pic.chinaz.com/picmap/202309151440044034_0.jpg\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🧠 医疗AI模型Baichuan-M3 Plus发布，医学幻觉率降至2.6%\u003c/p\u003e\u003cp\u003e📚 引入“六源循证范式”，确保诊断建议的\u003cspan class=\"spamTxt\"\u003e权威\u003c/span\u003e性\u003c/p\u003e\u003cp\u003e🏥 适用于医院、互联网医疗平台及医药研发机构，提升临床使用信心\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e4、视频创作告别手打代码：Remotion Skills 开启“一句话做大片”新时代\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eRemotion Skills 的推出标志着视频创作进入“AI 指令驱动”时代，用户只需自然语言指令即可生成专业视频动画，极大降低了创作门槛并提升了效率。\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://upload.chinaz.com/2026/0122/6390466960452798349736685.png\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🗣️ 用户可通过自然语言直接指挥 AI 生成复杂的 React 视频动画，无需手动编写繁琐代码。\u003c/p\u003e\u003cp\u003e🛠️ 智能体技能增强: 通过 Remotion Skills 工具集，AI 智能体可深度调用 Remotion 库，实现精准的像素级视频控制。\u003c/p\u003e\u003cp\u003e🚀 高效集成协作: 支持与 Claude Code 及 MCP 协议 无缝对接，极大地简化了程序化视频的制作流程与开发成本。\u003c/p\u003e\u003cp\u003e详情链接:https://www.remotion.dev/docs/ai/\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e5、苹果内部AI双系统首度曝光：Enchanté负责写代码改文案，Enterprise Assistant秒答十万条公司规章\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e苹果在2025年11月上线了两套生成式AI工具——Enchanté和Enterprise Assistant，旨在提升工程师、HR、营销和法务的日常工作效率。Enchanté能够快速完成代码补全、漏洞扫描和文案润色，而Enterprise Assistant则作为公司级搜索引擎，帮助员工快速获取内部文件信息。\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://upload.chinaz.com/2026/0122/6390466885669719149262413.png\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🍎 Enchanté通过本地或私有服务器处理运算，确保数据安全。\u003c/p\u003e\u003cp\u003e🔍 Enterprise Assistant利用大语言模型，实现自然语言提问并返回带引用的答案。\u003c/p\u003e\u003cp\u003e📊 苹果通过用户反馈优化模型，为消费者AI功能做准备。\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e6、YouTube 计划推出“AI个人形象”功能，Shorts 创作方式将迎新变化\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eYouTube 首席执行官尼尔·莫汉透露，未来创作者将能够使用自己的‘个人形象’来制作短视频内容。这一功能是 YouTube 持续扩展创作者工具的一部分，同时平台也在优化内容质量管理机制。\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e✨ YouTube 将允许创作者使用 AI 生成的个人形象制作 Shorts 内容。\u003c/p\u003e\u003cp\u003e🔍 平台正在优化内容质量机制，打击低质量内容和误导性标题。\u003c/p\u003e\u003cp\u003e🖼️ Shorts 将整合图片帖等多样化内容形式，提升用户浏览体验。\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e7、微软为Windows 11记事本与画图注入AI新能力：Markdown增强、流式生成、AI涂色书上线\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e微软在Windows 11的记事本和画图应用中注入了AI新能力，包括Markdown增强、流式生成和AI涂色书功能，展现了其将AI能力下沉至操作系统每一层的战略意图。\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🎨 画图新增AI涂色书功能，用户输入文本提示即可生成可填色线稿页面。\u003c/p\u003e\u003cp\u003e📝 记事本全面扩展对Markdown语法的支持，优化AI文本生成体验。\u003c/p\u003e\u003cp\u003e🔒 所有AI功能需登录微软账户启用，为未来个性化模型微调预留接口。\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e8、告别“人工智障”:苹果拟将 Siri 转型类 ChatGPT 机器人，代号“Campos”决战 iOS27\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e苹果计划将 Siri 重塑为类似 ChatGPT 的人工智能聊天机器人，代号“Campos”，并将其作为 2026 年 WWDC 开发者大会的核心亮点。新版 Siri 将支持语音与文本双输入，并集成于 iOS27 及其全线操作系统中，同时借助谷歌 Gemini 模型提升性能。\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e📱 交互进化：新版 Siri 支持语音与文本双输入，界面更接近 ChatGPT 或 Gemini 的对话流。\u003c/p\u003e\u003cp\u003e⚙️ 系统感知：Siri 将集成于 iOS27 及其全线操作系统中，具备网页深度搜索、内容生成、文档分析和屏幕内容感知能力。\u003c/p\u003e\u003cp\u003e🤝 强强联手：苹果与谷歌达成合作，Google Gemini 成为新版 Siri 及“苹果智能”的核心底层模型。\u003c/p\u003e\u003c/blockquote\u003e"])</script><script>self.__next_f.push([1,"7:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-white text-left\",\"children\":[[\"$\",\"$L1c\",null,{}],[\"$\",\"main\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"container mx-auto px-4 md:py-20 pt-20 pb-10\",\"children\":[\"$\",\"article\",null,{\"className\":\"md:pb-20 pb-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-[728px] tracking-wider mb-6 mx-auto flex flex-col flex-1\",\"children\":[\"$L1d\",[\"$\",\"$L1e\",null,{}],[\"$\",\"$L1f\",null,{\"article\":{\"Id\":24838,\"title\":\"玩美移动推出全新 API，让虚拟试穿成为时尚新风潮！\",\"subtitle\":\"玩美移动推出全新 API，让虚拟试穿成为时尚新风潮！\",\"description\":\"玩美移动升级时尚API，新增手表、手链等九类虚拟试穿功能，利用生成式AI和计算机视觉技术，精准识别人体结构，为品牌和开发者提供全面的AI穿搭体验，推动时尚行业发展。\",\"thumb\":\"\",\"classname\":\"\",\"summary\":\"\u003cp\u003e近日，玩美移动（Perfect Corp.，纽交所代码：PERF）在其时尚 API 中推出了一项重磅升级，新增了九个产品类别的虚拟试穿功能。这些类别包括手表、手链、戒指、耳环、项链、围巾、帽子、鞋子和包袋。这一创新旨在通过 AI 技术推动时尚行业的发展，为全球品牌和开发者提供全面的穿搭体验。\u003c/p\u003e\u003cp\u003e玩美移动的这项升级，依托于生成式 AI 和计算机视觉技术，能够精准识别人体结构、服装版型及环境光线，从而生成高度逼真的穿搭效果图。用户可以在系统中直观地查看各种配饰和单品的佩戴效果，这样不仅提升了购买信心，也增加了用户在电商平台的停留时间。\u003c/p\u003e\u003cp\u003e全新 API 与现有的服装及面料 API 协同工作，确保了用户体验的连贯性。系统智能适配用户特征，确保佩戴位置自然、尺寸精准，并且不同产品之间能够形成视觉上的和谐。同时，该 API 原生支持模型上下文协议（MCP），能够与电商平台、品牌官网、移动应用和全渠道零售场景完美兼容。这样的设计让品牌能够高效地生成高质量的图像输出，为消费者提供\u003cspan class=\\\"spamTxt\\\"\u003e最佳\u003c/span\u003e的购物体验。\u003c/p\u003e\u003cp\u003e随着这一新功能的推出，玩美移动正在不断完善 AI 驱动的时尚生态，助力品牌提升转化率并减少退货率。通过高效的云端基础设施，该系统为消费者带来了更为便利的虚拟试穿体验，意味着购物将变得更加轻松愉快。\u003c/p\u003e\u003cp\u003e总的来说，玩美移动的新 API 将引领虚拟试穿的新潮流，充分利用现代技术来提升消费者的购物体验，为时尚行业注入新的活力。\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\",\"tags\":\"[\\\"虚拟试穿\\\",\\\"生成式AI\\\",\\\"玩美移动\\\",\\\"AI技术\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2026-01-22T10:45:15.0317496+08:00\",\"upded\":1575334,\"updtime\":\"2026-01-22T10:45:15.0317498+08:00\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":60,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":5}}]]}]}]}],[\"$\",\"$f\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"mt-8 py-4 text-center text-gray-500\",\"children\":\"loading...\"}],\"children\":[\"$\",\"div\",null,{\"className\":\"bg-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"container mx-auto px-4 md:py-20 py-8\",\"children\":[\"$\",\"$L20\",null,{\"articles\":[{\"Id\":24858,\"title\":\"国产AI推理芯片新锐曦望一年融资近30亿元，获国资+产业+VC三方重注，加速GPU量产与生态突围\",\"subtitle\":\"国产AI推理芯片新锐曦望一年融资近30亿元\",\"description\":\"曦望（Sunrise）作为AI推理专用GPU芯片公司，在成立一年内完成近30亿元融资，创国内AI芯片初创企业早期融资纪录。此轮融资汇聚产业资本、头部VC/PE及国家级基金，显示市场对其技术及国产替代前景的认可。投资方包括三一集团旗下华胥基金等，凸显高端制造与AI芯片的战略协同。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/201901101704279841_1.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e在AI算力自主可控的国家战略驱动下，国产GPU赛道再迎重磅玩家。AI推理专用GPU芯片公司曦望（Sunrise）宣布，成立一年内已完成近 30 亿元人民币融资，创下国内AI芯片初创企业早期融资规模新高。此轮融资阵容罕见地集齐产业资本、头部VC/PE与\u003cspan class=\\\"spamTxt\\\"\u003e国家级\u003c/span\u003e基金三大势力，彰显市场对其技术路径与国产替代潜力的高度认可。\u003c/p\u003e\u003cp\u003e投资方包括：\u003c/p\u003e\u003cp\u003e- 产业资本：三一集团旗下华胥基金（聚焦高端制造与智能装备）、范式智能（港股6682，大模型与AI平台企业）、杭州数据集团（地方数据要素基础设施运营商）；\u003c/p\u003e\u003cp\u003e- 市场化VC/PE：IDG资本、高榕创投（885413.HK）、无极资本等；\u003c/p\u003e\u003cp\u003e- 国资背景基金：诚通混改基金等\u003cspan class=\\\"spamTxt\\\"\u003e国家级\u003c/span\u003e资本。\u003c/p\u003e\u003cp\u003e多方协同背后，是清晰的战略共识：AI推理芯片已成为大模型落地的关键瓶颈，而国产化替代窗口期正在快速关闭。曦望聚焦高性能、低功耗的推理场景，其GPU架构专为Transformer类模型优化，在能效比与部署成本上瞄准国际主流产品，目标直指数据中心、边缘服务器及行业AI终端市场。\u003c/p\u003e\u003cp\u003e据悉，本轮融资将主要用于三大方向：\u003c/p\u003e\u003cp\u003e1. 下一代推理GPU芯片研发，提升FP8/INT4 等低精度计算效率；\u003c/p\u003e\u003cp\u003e2. 规模化量产能力建设，打通从设计到封测的完整供应链；\u003c/p\u003e\u003cp\u003e3. 软件生态共建，包括驱动、编译器、算子库及与主流框架（PyTorch、TensorRT等）的深度适配。\u003c/p\u003e\u003cp\u003e值得注意的是，曦望选择“推理优先”而非“训练+推理”双线作战，显示出务实策略——在训练芯片仍被巨头垄断的当下，推理市场因应用场景碎片化、国产替代意愿强，反而成为国产GPU更易突破的“黄金赛道”。\u003c/p\u003e\u003cp\u003e随着大模型进入“降本增效”阶段，企业对高性价比、可自主可控的推理算力需求激增。曦望的快速崛起，不仅填补了国产AI芯片在推理领域的关键拼图，更标志着中国AI基础设施正从“可用”迈向“好用、敢用”的新阶段。在这场关乎算力主权的竞赛中，曦望已手握 30 亿“弹药”，准备全力冲刺。\u003c/p\u003e\",\"tags\":\"[\\\"AI推理芯片\\\",\\\"国产GPU\\\",\\\"曦望\\\",\\\"融资\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2026-01-22 17:58:47\",\"upded\":1575334,\"updtime\":\"2026-01-22 17:59:04\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":12},{\"Id\":24857,\"title\":\"蚂蚁数科金融AI落地保险业，与同方全球人寿签约保险AI创新应用\",\"subtitle\":\"蚂蚁数科金融AI落地保险业，与同方全球人寿签约保险AI创新应用\",\"description\":\"蚂蚁数科与同方全球人寿合作，以AI技术为核心深化保险全业务领域合作，旨在通过科技赋能重塑业务流程，提升运营效率与风控水平。AI技术已成为保险业高质量发展的重要引擎，头部险企纷纷将其列为战略重点。\",\"thumb\":\"https://upload.chinaz.com/2026/0122/6390470108497301019995552.png\",\"classname\":\"\",\"summary\":\"$21\",\"tags\":\"[\\\"AI新词\\\",\\\"保险AI\\\",\\\"智能理赔系统\\\",\\\"多模态大模型\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":45,\"addtime\":\"2026-01-22 17:51:37\",\"upded\":45,\"updtime\":\"2026-01-22 17:51:37\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":60,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":5},{\"Id\":24856,\"title\":\"​2. 4 万亿参数巨兽登场！百度发布文心大模型5.0：原生全模态技术重塑AI交互\",\"subtitle\":\"百度发布文心大模型5.0：原生全模态技术重塑AI交互\",\"description\":\"百度发布文心大模型5.0正式版，拥有2.4万亿参数，实现从多模态融合到“原生全模态”的跨越。其采用原生全模态统一建模技术，在统一架构中对文本、图像、视频和音频进行联合训练，区别于行业常见的“后期合成”方案。\",\"thumb\":\"https://upload.chinaz.com/2026/0122/6390470107364058477314124.png\",\"classname\":\"\",\"summary\":\"\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e\u0026nbsp;在今日举办的百度文心Moment大会上，百度正式发布了备受瞩目的文心大模型5.0正式版。这款拥有2.4万亿超大规模参数的“巨兽”，标志着百度在人工智能领域完成了从多模态融合向“原生全模态”的历史性跨越。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align:center\\\"\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e\u003cimg src=\\\"https://upload.chinaz.com/2026/0122/6390470107364058477314124.png\\\" title=\\\"image.png\\\" alt=\\\"image.png\\\"/\u003e\u003c/span\u003e\u003c/p\u003e\u003cp\u003e与行业普遍采用的“后期合成”方案不同，文心5.0采用了原生全模态统一建模技术。它在一个统一的自回归架构中，对文本、图像、视频和音频数据进行联合训练。这种技术路径让模型能够像人类大脑一样，在单一架构下实现多模态特征的深度融合，从而让机器的理解与生成能力变得更加自然且同步。\u003c/p\u003e\u003cp\u003e在实际应用场景中，文心5.0展现了惊人的智能。它不仅能轻松应对代码编写与创意写作，甚至能通过一段App教程视频，精准拆解交互逻辑并直接生成可运行的前端代码。此外，该模型在逻辑推理与情境创作方面也迎来了爆发，能够完美模拟特定古典文学风格处理现代商业逻辑。\u003c/p\u003e\u003cp style=\\\"text-align:center\\\"\u003e\u003cimg src=\\\"https://upload.chinaz.com/2026/0122/6390470108488775529183212.png\\\" title=\\\"image.png\\\" alt=\\\"image.png\\\"/\u003e\u003c/p\u003e\u003cp\u003e为了让技术真正落地，百度同步推出了“矩阵+专精”的应用模型体系。通过百度千帆平台，企业开发者可以调用包括文心5.0在内的150余个\u003cspan class=\\\"spamTxt\\\"\u003e顶尖\u003c/span\u003e模型。值得一提的是，全新的实时交互数字人技术已实现三态Token联动，大幅降低了数字人的交互延迟与制作成本。目前，文心5.0正式版已全面开放体验，正加速深入千行百业的生产流程中。\u003c/p\u003e\",\"tags\":\"[\\\"文心大模型5.0\\\",\\\"原生全模态\\\",\\\"自回归架构\\\",\\\"多模态融合\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1597147,\"addtime\":\"2026-01-22 17:51:33\",\"upded\":1597147,\"updtime\":\"2026-01-22 17:51:33\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":90,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":16},{\"Id\":24855,\"title\":\"企业AI算力自建潮兴起：1.5年回本、硬件配置成关键，金士顿推全栈解决方案\",\"subtitle\":\"企业AI算力自建潮兴起：1.5年回本、硬件配置成关键\",\"description\":\"随着AI成为企业必备工具，构建专属算力基础设施成为趋势。越来越多企业选择自建本地AI工作站，而非依赖云端API，主要出于数据安全、成本控制和业务稳定性的考量。自建硬件投入通常可在1.5至2.5年内收回成本，经济性优势明显。企业需根据任务复杂度匹配不同规模的算力方案。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202306131354261338_2.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e随着AI从“可选项”变为“必选项”，企业正加速构建专属算力基础设施——无论大型集团还是小微企业，都在认真评估：是调用云端API，还是自建本地AI工作站？\u003cspan class=\\\"spamTxt\\\"\u003e最新\u003c/span\u003e趋势显示，越来越多企业选择后者，尤其在数据安全、成本控制与长期业务稳定性要求较高的场景下，自建AI硬件投入通常可在1. 5 至2. 5 年内收回成本，经济性优势日益凸显。\u003c/p\u003e\u003cp\u003e根据任务复杂度，企业需匹配不同规模的模型与硬件配置：\u003c/p\u003e\u003cp\u003e- 7B参数模型：适用于基础文本生成、客服问答等轻量任务，推荐入门级GPU（如RTX 4090）搭配64GB内存、高速NVMe SSD；\u003c/p\u003e\u003cp\u003e- 13B参数模型：可处理多轮对话、逻辑推理与简单代码生成，需双GPU或专业级显卡（如A6000），内存建议128GB以上；\u003c/p\u003e\u003cp\u003e- 70B级大模型：面向深度分析、科研仿真或企业级Agent部署，必须采用多卡服务器架构（如8×A100/H100），配备TB级内存与高带宽存储系统。\u003c/p\u003e\u003cp\u003e值得注意的是，GPU并非\u003cspan class=\\\"spamTxt\\\"\u003e唯一\u003c/span\u003e关键。内存容量与带宽、硬盘I/O性能、电源稳定性及散热效率，共同决定系统能否长期高效运行。专家强调：“性能瓶颈往往出现在最弱一环”——例如，高速GPU若搭配低速硬盘，将严重拖累模型加载与推理速度。因此，均衡配置比堆砌\u003cspan class=\\\"spamTxt\\\"\u003e顶级\u003c/span\u003e部件更重要。\u003c/p\u003e\u003cp\u003e在此背景下，金士顿科技推出面向企业AI场景的全栈硬件解决方案，涵盖高性能DDR5 内存、企业级NVMe固态硬盘及定制化存储架构，强调高可靠性、长期供货保障与专业技术支持，助力企业规避“买得起GPU、跑不稳系统”的常见陷阱。\u003c/p\u003e\u003cp\u003e对于中小企业而言，自建AI工作站不仅是技术升级，更是战略自主权的体现：既避免敏感数据上传公有云，又可灵活迭代私有模型。而在全球算力供应链波动的当下，本地化部署更显韧性价值。\u003c/p\u003e\u003cp\u003e当AI进入“落地为王”时代，算力基建的理性选择，正成为企业智能化转型的\u003cspan class=\\\"spamTxt\\\"\u003e第一\u003c/span\u003e道分水岭。\u003c/p\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"品牌产品词\\\",\\\"算力基础设施\\\",\\\"GPU\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2026-01-22 17:51:31\",\"upded\":1575334,\"updtime\":\"2026-01-22 17:51:31\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":25},{\"Id\":24854,\"title\":\"月之暗面Kimi亮相达沃斯：用1%算力超越美国闭源模型，工程化思维成中国AI突围关键\",\"subtitle\":\"月之暗面Kimi亮相达沃斯：用1%算力超越美国闭源模型\",\"description\":\"中国AI公司月之暗面在达沃斯论坛宣布，其Kimi模型仅用美国顶尖实验室1%的计算资源，便研发出性能领先的开源大模型，部分指标超越美国闭源模型，展示了高效创新的技术路径。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202405240907574564_1.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e在 2026 年世界经济论坛达沃斯年会上，月之暗面（Moonshot）Kimi总裁张予彤向全球科技界抛出一枚“震撼弹”：Kimi仅使用美国\u003cspan class=\\\"spamTxt\\\"\u003e顶尖\u003c/span\u003eAI实验室约1%的计算资源，便成功推出Kimi K2、Kimi K2 Thinking等全球领先的开源大模型，并在部分关键性能指标上超越美国主流闭源模型。\u003c/p\u003e\u003cp\u003e这一表态不仅彰显了中国AI团队在效率与创新上的\u003cspan class=\\\"spamTxt\\\"\u003e极致\u003c/span\u003e追求，更揭示了一条不同于“算力堆砌”的技术路径——以工程化思维驱动AI研发。张予彤强调，Kimi团队将大量精力投入于“让算法真正跑在生产系统里”：从训练稳定性、推理延迟到多任务泛化能力，每一项研究都以大规模落地为前提，确保模型不仅是论文中的SOTA，更是用户手中的可靠工具。\u003c/p\u003e\u003cp\u003e这种“研以致用”的理念，使Kimi在有限资源下实现了惊人突破。例如，Kimi K2 Thinking通过创新的推理架构，在复杂任务链处理与长上下文一致性上表现优异；而其开源策略也加速了社区反馈与迭代，形成良性生态循环。\u003c/p\u003e\u003cp\u003e张予彤还透露，Kimi\u003cspan class=\\\"spamTxt\\\"\u003e最新\u003c/span\u003e一代模型即将发布，将进一步强化多模态理解、Agent协作与成本效率优势。尽管未披露具体细节，但结合其此前在长文本、代码生成等领域的领先表现，新模型有望在企业级AI应用市场掀起新一轮竞争。\u003c/p\u003e\u003cp\u003e在全球AI竞赛日益演变为“算力军备竞赛”的背景下，月之暗面的选择提供了一种清醒的替代方案：真正的智能，不在于消耗多少电力，而在于如何用最少的资源解决最多的问题。当美国巨头以千卡集群冲刺AGI时，中国团队正用工程智慧证明——高效、稳定、可落地的AI，同样能站在世界之巅。\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"KimiK2\\\",\\\"月之暗面\\\",\\\"开源大模型\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2026-01-22 17:14:05\",\"upded\":1575334,\"updtime\":\"2026-01-22 17:14:05\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":17},{\"Id\":24853,\"title\":\"​微软发布 Rho-alpha 模型：赋予 AI 机器人“人手”般灵活性与理解力\",\"subtitle\":\"​微软发布 Rho-alpha 模型：赋予 AI 机器人“人手”般灵活性与理解力\",\"description\":\"微软推出Rho-alpha AI模型，推动机器人技术向“物理AI”转型。该模型旨在让机器人适应复杂多变的现实环境，摆脱对预设场景的依赖，并能理解并执行人类自然语言指令。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/201811151633428399_20.jpg\",\"classname\":\"\",\"summary\":\"$22\",\"tags\":\"[\\\"物理AI\\\",\\\"Rho-alpha\\\",\\\"微软\\\",\\\"AI模型\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1597147,\"addtime\":\"2026-01-22 16:55:12\",\"upded\":1597147,\"updtime\":\"2026-01-22 16:55:12\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":14},{\"Id\":24852,\"title\":\"​拒绝“AI垃圾”侵权：斯嘉丽·约翰逊等 800 名创意人士联名抗议技术盗窃\",\"subtitle\":\"​拒绝“AI垃圾”侵权：斯嘉丽·约翰逊等 800 名创意人士联名抗议技术盗窃\",\"description\":\"美国文艺界约800名创意人士联名抗议AI公司未经授权使用原创内容训练模型，谴责其为“规模空前的盗窃”，行动名为“偷窃不是创新”。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202308311057046863_1.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e近日，美国文艺界爆发了一场针对人工智能技术滥用的集体抗议。据 IT之家 援引外媒消息，约 800 名来自文学、影视及音乐领域的知名创意人士发表联合声明，公开谴责AI公司在模型训练中未经授权抓取原创内容的行为，并将其定性为“规模空前的盗窃”。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e此次联名行动名为“偷窃不是创新”，阵容极为豪华。名单中不仅包括文学巨匠乔治·桑德斯、乔迪·皮库尔特，还涵盖了凯特·布兰切特、斯嘉丽·约翰逊等好莱坞顶流明星，以及 R.E.M. 乐队等乐坛重量级代表。这些创作者一致认为，以利润为导向的科技公司正通过大规模抓取、复制网络上的创意作品来谋求商业主导权，而这一过程从未征得作者同意，也未支付任何报酬。\u003c/p\u003e\u003cp\u003e声明进一步指出，这种对知识产权的非法掠夺正引发连锁反应：互联网正在被错误信息、深度伪造（Deepfake）以及大量低质量的“AI垃圾”所充斥。这种恶劣的信息环境不仅可能导致AI模型自身的系统性失效，长期来看还将削弱国家在人工智能领域的全球竞争优势。\u003c/p\u003e\u003cp\u003e该行动由“人类艺术性运动”发起，得到了美国唱片业协会、演员工会（SAG-AFTRA）以及多个职业体育联盟的支持。参与者们明确提出了核心诉求：必须建立完善的AI训练授权机制与执法体系，并赋予创作者明确的权利，让他们能够自主选择是否允许自己的作品进入AI的“胃口”。\u003c/p\u003e\u003cp\u003e目前，监管层与行业内部正处于博弈阶段。尽管白宫及部分科技巨头试图限制地方监管权限，但市场已出现分化迹象。一些唱片公司和数字媒体开始尝试与AI公司达成单独授权协议，通过付费合作来取代法律对抗。这一转变也预示着，在保护版权与推动技术进步之间，业界正在艰难寻找新的平衡点。\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"深度伪造\\\",\\\"人工智能技术\\\",\\\"知识产权\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1597147,\"addtime\":\"2026-01-22 16:46:54\",\"upded\":1597147,\"updtime\":\"2026-01-22 16:46:54\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":60,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":3},{\"Id\":24851,\"title\":\"​影视飓风 Tim 挑战零下 30℃雪地生存，仅凭一纸笔和 AI 识图！\",\"subtitle\":\"​影视飓风 Tim 挑战零下 30℃雪地生存，仅凭一纸笔和 AI 识图！\",\"description\":\"影视飓风创始人Tim宣布，将于1月23日在零下30℃的东北雪地中挑战生存100小时。此次挑战规则独特：他仅携带纸笔，需通过手绘图案，由AI识别后换取生存物资，全程不携带任何其他物品。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202304121653002554_10.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e影视飓风创始人 Tim（潘天鸿）在社交上发布了一段视频，宣布将于 1 月 23 日上午 11:00 开启一项全新的 —— 在东北寒的零 30℃雪地中生存 100 小时。与以往不同的是，这次 Tim 仅携带一纸一笔，所有物资的都要依赖于人工智能的识图功能。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e挑战规则，Tim 在生存过程中无法携带任何物资，只有张纸和一支笔。他需要通过在纸上绘图案，AI 识别后才能获得对应的生存物资。这一挑战的硬程度引起了网友们的热议，不少人表示这将是更为严酷的考验。有网友调侃道如果画个大子出来，能实现吗？” 还有人提到在如此寒冷的天气下，单单用手写自己的名字都很困难，更别提画了。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003eTim 的项挑战并非\u003c/span\u003e\u003cspan class=\\\"spamTxt\\\" style=\\\"text-indent: 2em;\\\"\u003e\u003cspan class=\\\"spamTxt\\\"\u003e首次\u003c/span\u003e\u003c/span\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e，他去年月在一座无人荒岛上进行了为期 100 的生存挑战样是全程通过直播展示。那次挑战吸了 4150 万 B 站用户进入间，累计观看次数达到了 1.69 亿次直播期间更是曾创造出万人同时在线的峰值记录。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"品牌产品词\\\",\\\"生存挑战\\\",\\\"人工智能\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1597147,\"addtime\":\"2026-01-22 16:30:01\",\"upded\":1597147,\"updtime\":\"2026-01-22 16:30:01\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":29},{\"Id\":24850,\"title\":\"AI日报：天猫上线AI假图识别模型；百川发布医学模型Baichuan-M3 Plus；Remotion Skills开启一句话做大片时代\",\"subtitle\":\"AI日报：天猫上线AI假图识别模型；百川发布Baichuan-M3 Plus\",\"description\":\"欢迎来到【AI日报】栏目!这里是你每天探索人工智能世界的指南，每天我们为你呈现AI领域的热点内容，聚焦开发者，助你洞悉技术趋势、了解创新AI产品应用。新鲜AI产品点击了解：https://app.aibase.com/zh1、淘宝天猫出重拳！新版Siri将支持语音与文本双输入，并集成于iOS27及其全线操作系统中，同时借助谷歌Gemini模型提升性能。\",\"thumb\":\"https://upload.chinaz.com/2026/0122/6390468789177345485696856.png\",\"classname\":\"\",\"summary\":\"$23\",\"tags\":\"[\\\"AI日报\\\",\\\"AI假图识别模型\\\",\\\"淘宝天猫\\\",\\\"AI产品\\\"]\",\"sourcename\":\"站长之家\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":6,\"added\":1575334,\"addtime\":\"2026-01-22 16:20:21\",\"upded\":1575334,\"updtime\":\"2026-01-22 16:25:44\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":100,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":1},{\"Id\":24849,\"title\":\"微软为Windows 11记事本与画图注入AI新能力：Markdown增强、流式生成、AI涂色书上线\",\"subtitle\":\"微软为Windows 11记事本与画图注入AI新能力：Markdown增强上线\",\"description\":\"微软为Windows记事本和画图应用加入AI功能，支持Markdown语法和嵌套列表，提升生产力，适应Copilot+ PC时代。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202209261016289616_0.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e微软正悄然将AI能力渗透到最基础的Windows应用中。近日，面向Canary和Dev频道用户，微软推送了记事本（Notepad）与画图（Paint）的重大更新，不仅强化传统功能，更深度集成生成式AI，让这两个“元老级”应用焕发出面向Copilot+ PC时代的智能活力。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e记事本迎来生产力升级：\u0026nbsp;\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e新版全面扩展对Markdown语法的支持，新增删除线（~~strikethrough~~）、嵌套列表等格式，满足开发者与内容创作者的轻量级写作需求。更关键的是，AI文本生成体验大幅优化——无论是写作辅助还是摘要生成，内容 now 以“流式”方式逐字呈现，响应速度显著提升，减少等待感，让创作过程更流畅自然。启动时的新欢迎界面也直观展示了这些新特性，降低用户学习门槛。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e画图则变身AI创意工具：\u0026nbsp;\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e全新推出的“AI涂色书”（AI Coloring Book）功能成为\u003cspan class=\\\"spamTxt\\\"\u003e最大\u003c/span\u003e亮点。用户只需输入文本提示（如“一只戴着草帽的猫在海滩上”），画图即可自动生成可填色的线稿页面，特别适配Copilot+ PC的NPU加速能力，实现本地化、低延迟的AI绘图体验。同时，新增的填充容差滑块让用户能精细控制油漆桶工具的上色范围，提升数字绘画精度。\u003c/p\u003e\u003cp\u003e值得注意的是，所有AI功能均需登录微软账户启用，既用于身份验证，也为未来个性化模型微调预留接口。\u003c/p\u003e\u003cp\u003e此次更新虽聚焦于两款基础应用，却释放出强烈信号：微软正通过“润物细无声”的方式，将AI能力下沉至操作系统每一层。当连记事本都能智能生成摘要、画图可凭一句话作画，AI便不再是高高在上的技术，而是融入日常数字生活的隐形助手。随着Copilot+生态持续扩展，Windows的“基础应用矩阵”或将成为微软AI战略最广泛的触点。\u003c/p\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"微软\\\",\\\"记事本\\\",\\\"画图\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2026-01-22 15:10:23\",\"upded\":1575334,\"updtime\":\"2026-01-22 16:10:26\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":1,\"sites\":\"\",\"categrates\":\"\",\"pv\":19}],\"flag\":\"zh\"}]}]}]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"24:I[80297,[\"902\",\"static/chunks/902-27772842be6816ea.js\",\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"1337\",\"static/chunks/1337-81d43bfacef9d960.js\",\"6812\",\"static/chunks/6812-40cdafdaa8a94ce7.js\",\"2556\",\"static/chunks/2556-4d7c9cf06d447398.js\",\"7976\",\"static/chunks/7976-4f9c77f2476a84cf.js\",\"7150\",\"static/chunks/7150-e5e713f21ff63792.js\",\"1782\",\"static/chunks/1782-d3ba7b56fa54830d.js\",\"9558\",\"static/chunks/9558-b084350b79199c0b.js\",\"8615\",\"static/chunks/8615-36f4ddf19f5530c3.js\",\"28\",\"static/chunks/28-3bc0b4a8bc2521b2.js\",\"5151\",\"static/chunks/5151-77a2eea8ff597dab.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-e0ecc169116052d4.js\"],\"LocalizedLink\"]\n25:I[38181,[\"902\",\"static/chunks/902-27772842be6816ea.js\",\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"1337\",\"static/chunks/1337-81d43bfacef9d960.js\",\"6812\",\"static/chunks/6812-40cdafdaa8a94ce7.js\",\"2556\",\"static/chunks/2556-4d7c9cf06d447398.js\",\"7976\",\"static/chunks/7976-4f9c77f2476a84cf.js\",\"7150\",\"static/chunks/7150-e5e713f21ff63792.js\",\"1782\",\"static/chunks/1782-d3ba7b56fa54830d.js\",\"9558\",\"static/chunks/9558-b084350b79199c0b.js\",\"8615\",\"static/chunks/8615-36f4ddf19f5530c3.js\",\"28\",\"static/chunks/28-3bc0b4a8bc2521b2.js\",\"5151\",\"static/chunks/5151-77a2eea8ff597dab.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-e0ecc169116052d4.js\"],\"ArticleMeta\"]\n"])</script><script>self.__next_f.push([1,"1d:[\"$\",\"div\",null,{\"className\":\"px-4 flex flex-col mt-8 md:mt-16\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"md:text-4xl text-3xl leading-[42px] md:leading-[48px] font-extrabold text-[#242424]\",\"children\":\"玩美移动推出全新 API，让虚拟试穿成为时尚新风潮！\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-10 h-10 rounded-full overflow-hidden mr-4 flex-shrink-0\",\"children\":[\"$\",\"img\",null,{\"className\":\"object-cover h-full w-full\",\"src\":\"https://app.aibase.com/icon/logo.png\",\"alt\":\"aibase\",\"width\":40,\"height\":40}]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"text-surface-600\",\"children\":\"AIbase基地\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center flex-wrap text-sm text-surface-500\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-1\",\"children\":\"发布于\"}],[\"$\",\"$L24\",null,{\"href\":\"/news/\",\"className\":\"text-surface-700\",\"children\":\"AI新闻资讯\"}],[\"$\",\"span\",null,{\"className\":\"mx-2 inline-block\",\"children\":\" · \"}],[\"$\",\"span\",null,{\"children\":[1,\" \",\"分钟阅读\"]}],[\"$\",\"span\",null,{\"className\":\"mx-2 inline-block\",\"children\":\" · \"}],[\"$\",\"span\",null,{\"children\":\"Jan 22, 2026\"}]]}]]}]]}],[\"$\",\"$L25\",null,{\"article\":\"$7:props:children:1:props:children:0:props:children:props:children:props:children:2:props:article\"}],[\"$\",\"div\",null,{\"className\":\"leading-8 text-[#242424] post-content md:mt-12 mt-8 text-lg space-y-7 text-wrap break-words overflow-hidden\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003e近日，玩美移动（Perfect Corp.，纽交所代码：PERF）在其时尚 API 中推出了一项重磅升级，新增了九个产品类别的虚拟试穿功能。这些类别包括手表、手链、戒指、耳环、项链、围巾、帽子、鞋子和包袋。这一创新旨在通过 AI 技术推动时尚行业的发展，为全球品牌和开发者提供全面的穿搭体验。\u003c/p\u003e\u003cp\u003e玩美移动的这项升级，依托于生成式 AI 和计算机视觉技术，能够精准识别人体结构、服装版型及环境光线，从而生成高度逼真的穿搭效果图。用户可以在系统中直观地查看各种配饰和单品的佩戴效果，这样不仅提升了购买信心，也增加了用户在电商平台的停留时间。\u003c/p\u003e\u003cp\u003e全新 API 与现有的服装及面料 API 协同工作，确保了用户体验的连贯性。系统智能适配用户特征，确保佩戴位置自然、尺寸精准，并且不同产品之间能够形成视觉上的和谐。同时，该 API 原生支持模型上下文协议（MCP），能够与电商平台、品牌官网、移动应用和全渠道零售场景完美兼容。这样的设计让品牌能够高效地生成高质量的图像输出，为消费者提供\u003cspan class=\\\"spamTxt\\\"\u003e最佳\u003c/span\u003e的购物体验。\u003c/p\u003e\u003cp\u003e随着这一新功能的推出，玩美移动正在不断完善 AI 驱动的时尚生态，助力品牌提升转化率并减少退货率。通过高效的云端基础设施，该系统为消费者带来了更为便利的虚拟试穿体验，意味着购物将变得更加轻松愉快。\u003c/p\u003e\u003cp\u003e总的来说，玩美移动的新 API 将引领虚拟试穿的新潮流，充分利用现代技术来提升消费者的购物体验，为时尚行业注入新的活力。\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\"},\"style\":{\"wordBreak\":\"break-word\",\"overflowWrap\":\"break-word\",\"hyphens\":\"auto\"}}],[\"$\",\"div\",null,{\"className\":\"my-8 flex space-x-3 flex-wrap\",\"children\":[[\"$\",\"$L24\",\"虚拟试穿\",{\"href\":\"/search/虚拟试穿\u0026type=0\",\"className\":\"tag-badge mb-4 cursor-pointer text-sm hover:bg-slate-200 bg-slate-100 text-slate-800 rounded inline-block py-1 px-2\",\"children\":\"虚拟试穿\"}],[\"$\",\"$L24\",\"生成式AI\",{\"href\":\"/search/生成式AI\u0026type=0\",\"className\":\"tag-badge mb-4 cursor-pointer text-sm hover:bg-slate-200 bg-slate-100 text-slate-800 rounded inline-block py-1 px-2\",\"children\":\"生成式AI\"}],[\"$\",\"$L24\",\"玩美移动\",{\"href\":\"/search/玩美移动\u0026type=0\",\"className\":\"tag-badge mb-4 cursor-pointer text-sm hover:bg-slate-200 bg-slate-100 text-slate-800 rounded inline-block py-1 px-2\",\"children\":\"玩美移动\"}],[\"$\",\"$L24\",\"AI技术\",{\"href\":\"/search/AI技术\u0026type=0\",\"className\":\"tag-badge mb-4 cursor-pointer text-sm hover:bg-slate-200 bg-slate-100 text-slate-800 rounded inline-block py-1 px-2\",\"children\":\"AI技术\"}]]}]]}]\n"])</script></body></html>