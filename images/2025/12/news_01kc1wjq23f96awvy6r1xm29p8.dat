\":\"产品库\"},\"services-news\":{\"name\":\"AI头条\"},\"services-tools\":{\"name\":\"AI导航\"},\"services-category\":{\"name\":\"AI产品榜\"}},\"home\":{\"title\":\"欢迎来到 AIbase\",\"description\":\"您的 AI 工具平台\",\"video\":{\"title\":\"热门AI视频\",\"desc\":\"\"},\"news\":{\"title\":\"新鲜AI资讯\",\"desc\":\"实时更新AI行业的最新资讯\"},\"category\":{\"title\":\"热门应用分类\",\"desc\":\"\"},\"product\":{\"title\":\"最新AI产品\",\"desc\":\"\"},\"money\":{\"title\":\"最新变现指南\",\"desc\":\"获取最新AI赚钱攻略和实操案例\"},\"rank\":{\"title\":\"热门AI榜单\",\"desc\":\"全面展示人工智能的最新产品榜单数据\"},\"repo\":{\"title\":\"热门AI开源项目\",\"desc\":\"为您提供最全面的AI开源项目库\"},\"model\":{\"title\":\"热门AI模型\",\"desc\":\"为您提供最全面的AI模型库\"},\"agent\":{\"title\":\"热门AI Agent分类\",\"desc\":\"为您提供最全面的AI Agent分类库\"},\"newsLatest\":{\"title\":\"最新AI资讯\",\"desc\":\"最新发布的AI相关资讯\"},\"videoLatest\":{\"title\":\"热门AI视频\",\"desc\":\"最新发布的AI相关视频\"},\"weekTop\":{\"title\":\"一周热榜\",\"desc\":\"一周内最受关注的AI新闻\"},\"latestProductRecommend\":{\"title\":\"最新收录推荐\",\"desc\":\"最新收录的AI产品推荐\"},\"weekProductTop\":{\"title\":\"周流量飙升榜\",\"desc\":\"周流量飙升的AI产品推荐\"},\"monthProductTop\":{\"title\":\"月流量飙升榜\",\"desc\":\"月流量飙升的AI产品推荐\"}},\"privacy\":\"隐私政策\",\"productBaseTitle\":\"AIbase AI产品库\",\"updateText\":\"产品库更新时间\",\"cooperationText\":\"商务合作\",\"newsMenu\":{\"title\":\"AI资讯_获取AGI最新头条资讯_AIbase\",\"description\":\"AI 每日资讯汇集了国内外关于人工智能、大语言模型、多模态模型、机器学习、深度学习、计算机视觉、自然语言处理、数据科学和大数据的所有顶级新闻、视频等内容，一站式获取最新AI资讯。\",\"keywords\":\"AI资讯, 人工智能, AI行业趋势, AI技术, AI新闻, AI动态, AI市场分析, AI模型, AI独家分析, AI深度解读\",\"news\":\"AI新闻资讯\",\"daily\":\"AI 日报\",\"missed\":\"不错过全球AI革新的每一个时刻\",\"headlines\":\"AI头条\",\"type\":\"类型\",\"newsInfo\":\"新闻资讯\",\"popularVideos\":\"热门视频\",\"readMore\":\"查看头条\",\"tools\":\"产品应用\",\"cases\":\"变现案例\",\"course\":\"AI教程\",\"relatedNews\":\"相关AI新闻推荐\"},\"article\":{\"minRead\":\"分钟阅读\",\"publishedBy\":\"发布于\",\"share\":\"分享\",\"copyLink\":\"复制链接\",\"copyed\":\"链接已复制\",\"copyErr\":\"无法复制到剪贴板:\",\"copyright\":\"© 版权所有 AIbase基地 2024, 点击查看来源出处 - \",\"author\":\"AIbase 资讯组\",\"report\":\"举报\",\"view