tic/chunks/3658-ce4d23d9f61b3d71.js\",\"570\",\"static/chunks/570-921e7c24d307cf67.js\",\"2099\",\"static/chunks/2099-2d4e810935ebf618.js\",\"1345\",\"static/chunks/1345-9cbdb7de935bb6f8.js\",\"6014\",\"static/chunks/6014-fd967af2cd377f19.js\",\"3479\",\"static/chunks/3479-160df37dc9d3af1b.js\",\"6396\",\"static/chunks/6396-6ba6bdcdfe66440a.js\",\"5978\",\"static/chunks/5978-53d10df9994c37c9.js\",\"5151\",\"static/chunks/5151-15e5c4a6b6125374.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-5050e0732c7f73f0.js\"],\"default\"]\n1e:I[70267,[\"6453\",\"static/chunks/6453-8d86949207f0d049.js\",\"6874\",\"static/chunks/6874-4d0275c9ddac042c.js\",\"6995\",\"static/chunks/6995-8c03d599553cd188.js\",\"3658\",\"static/chunks/3658-ce4d23d9f61b3d71.js\",\"570\",\"static/chunks/570-921e7c24d307cf67.js\",\"2099\",\"static/chunks/2099-2d4e810935ebf618.js\",\"1345\",\"static/chunks/1345-9cbdb7de935bb6f8.js\",\"6014\",\"static/chunks/6014-fd967af2cd377f19.js\",\"3479\",\"static/chunks/3479-160df37dc9d3af1b.js\",\"6396\",\"static/chunks/6396-6ba6bdcdfe66440a.js\",\"5978\",\"static/chunks/5978-53d10df9994c37c9.js\",\"5151\",\"static/chunks/5151-15e5c4a6b6125374.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-5050e0732c7f73f0.js\"],\"default\"]\n1f:I[69883,[\"6453\",\"static/chunks/6453-8d86949207f0d049.js\",\"6874\",\"static/chunks/6874-4d0275c9ddac042c.js\",\"6995\",\"static/chunks/6995-8c03d599553cd188.js\",\"3658\",\"static/chunks/3658-ce4d23d9f61b3d71.js\",\"570\",\"static/chunks/570-921e7c24d307cf67.js\",\"2099\",\"static/chunks/2099-2d4e810935ebf618.js\",\"1345\",\"static/chunks/1345-9cbdb7de935bb6f8.js\",\"6014\",\"static/chunks/6014-fd967af2cd377f19.js\",\"3479\",\"static/chunks/3479-160df37dc9d3af1b.js\",\"6396\",\"static/chunks/6396-6ba6bdcdfe66440a.js\",\"5978\",\"static/chunks/5978-53d10df9994c37c9.js\",\"5151\",\"static/chunks/5151-15e5c4a6b6125374.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-5050e0732c7f73f0.js\"],\"ArticleActions\"]\n20:I[94689,[\"6453"])</script><script>self.__next_f.push([1,"\",\"static/chunks/6453-8d86949207f0d049.js\",\"6874\",\"static/chunks/6874-4d0275c9ddac042c.js\",\"6995\",\"static/chunks/6995-8c03d599553cd188.js\",\"3658\",\"static/chunks/3658-ce4d23d9f61b3d71.js\",\"570\",\"static/chunks/570-921e7c24d307cf67.js\",\"2099\",\"static/chunks/2099-2d4e810935ebf618.js\",\"1345\",\"static/chunks/1345-9cbdb7de935bb6f8.js\",\"6014\",\"static/chunks/6014-fd967af2cd377f19.js\",\"3479\",\"static/chunks/3479-160df37dc9d3af1b.js\",\"6396\",\"static/chunks/6396-6ba6bdcdfe66440a.js\",\"5978\",\"static/chunks/5978-53d10df9994c37c9.js\",\"5151\",\"static/chunks/5151-15e5c4a6b6125374.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-5050e0732c7f73f0.js\"],\"default\"]\n21:Tb90,"])</script><script>self.__next_f.push([1,"\u003cp\u003e根据《金融时报》的一项分析报告，随着科技巨头们在数据中心的投资不断增加，美国的电网正面临巨大的压力。这项报告指出，预计到2028年，AI 数据中心的新增电力需求将达到44吉瓦（GW），但由于电网基础设施的瓶颈，只有大约25吉瓦的新增电力供应能够上线。这意味着将出现约19吉瓦的电力缺口，占总需求的40%。\u003c/p\u003e\u003cp style=\"text-align: center\"\u003e\u003cimg src=\"https://pic.chinaz.com/picmap/202302150929449091_0.jpg\" title=\"OpenAI，ChatGPT，人工智能，AI (图片来源：官方或第三方截图)\" alt=\"OpenAI，ChatGPT，人工智能，AI\"/\u003e\u003c/p\u003e\u003cp\u003e在此背景下，主要的 “超大规模” 企业，包括亚马逊、谷歌、Meta 和微软，已经规划超过4000亿美元的投资，主要用于建设数据中心。OpenAI 更是签署了总额高达1.4万亿美元的基础设施合同，以确保在未来八年内获得约28吉瓦的电力。OpenAI 首席执行官山姆・阿尔特曼称这种能源短缺为 “生死存亡的威胁”，因为没有足够的计算能力，公司无法在必要的规模上产生收入或构建模型。\u003c/p\u003e\u003cp\u003e报告还提到，美国的电网基础设施正因年久失修而无法跟上需求增长，许多电线杆和变压器的使用年限可追溯到20世纪60年代和70年代。此外，行政审批程序冗长，从申请电网连接到商业运营的平均等待时间已超过八年。同时，一些开发商通过向不同的公用事业公司提交多个申请来提高竞争力，进一步加剧了排队的现象。\u003c/p\u003e\u003cp\u003e为了应对电力供应问题，越来越多的 AI 公司开始寻求 “门后发电” 的解决方案。例如，Elon Musk 的 xAI 公司在田纳西州的 “Colossus” 集群项目中，使用了未经环保许可的天然气涡轮发电机。OpenAI 也在德克萨斯州的 “Stargate” 项目中计划使用十台天然气涡轮机，而微软则计划通过重启 “三哩岛” 核电站来获得电力支持。\u003c/p\u003e\u003cp\u003e随着美国科技行业将其对电力的渴求视为国家安全问题，OpenAI 在致信美国政府时指出，中国在基础设施建设方面已逐渐领先。确实，2024年中国新增的电力容量达429吉瓦，几乎是美国整个电网容量的三分之一。而在同一时期，美国仅增加了51吉瓦的电力。环境保护人士则警告，倘若电力缺口得不到解决，AI 行业可能会面临泡沫破裂的风险。\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e划重点:\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e⚡️ 到2028年，AI 数据中心预计需要44吉瓦的新增电力，但电网只能提供25吉瓦，缺口达19吉瓦。\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e🏗️ 主要科技公司在数据中心建设上的投资超4000亿美元，OpenAI 单独签署了1.4万亿美元的基础设施合同。\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e🌍 随着国家安全问题的凸显，美国急需加快电力基础设施的建设以应对中国的竞争。\u003c/p\u003e\u003c/blockquote\u003e"])</script><script>self.__next_f.push([1,"22:T1e7f,"])</script><script>self.__next_f.push([1,"\u003cp\u003e欢迎来到【AI日报】栏目!这里是你每天探索人工智能世界的指南，每天我们为你呈现AI领域的热点内容，聚焦开发者，助你洞悉技术趋势、了解创新AI产品应用。\u003c/p\u003e\u003cp\u003e新鲜AI产品\u003cstrong\u003e点击了解\u003c/strong\u003e：\u003ca href=\"https://app.aibase.com/zh\" style=\"color: rgb(255, 0, 0); text-decoration: underline;\"\u003e\u003cspan style=\"color: rgb(255, 0, 0);\"\u003ehttps://app.aibase.com/zh\u003c/span\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e1、智谱开源 GLM-4.6V 系列：106B 原生支持 Function Call，轻量版 9B 免费商用\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e智谱开源 GLM-4.6V 系列模型，具备强大的多模态处理能力和原生 Function Call 功能，同时提供免费的轻量版和价格优惠的基础版，适合多种应用场景。\u003c/p\u003e\u003cp style=\"text-align:center\"\u003e\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://pic.chinaz.com/picmap/202406051435016830_1.jpg\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🧠 128k 多模态上下文支持，提升长视频理解能力\u003c/p\u003e\u003cp\u003e🛠️ 原生 Function Call 能力，直接触发 API，降低延迟和提升成功率\u003c/p\u003e\u003cp\u003e💰 轻量版免费商用，基础版价格腰斩，降低使用门槛\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e2、蚂蚁集团推出灵光网页版 AI 助手，30 秒打造小应用\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e蚂蚁集团推出的灵光网页版AI助手，为用户提供便捷、高效的工作与学习工具，支持30秒生成小应用并实现多端数据同步，同时聚焦职场与教育场景，提升用户效率和创作体验。\u003c/p\u003e\u003cp style=\"text-align:center\"\u003e\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://upload.chinaz.com/2025/1209/6390087516757824485555397.png\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e💡 灵光网页版AI助手正式推出，用户可通过浏览器体验核心功能。\u003c/p\u003e\u003cp\u003e🚀 支持30秒生成小应用，并实现与移动端的数据同步。\u003c/p\u003e\u003cp\u003e📈 聚焦职场与教育场景，优化用户工作效率与创作体验。\u003c/p\u003e\u003cp\u003e详情链接:https://www.lingguang.com/chat\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e3、谷歌Mixboard重磅升级：Nano Banana Pro加持，无限画布秒变演示文稿\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e谷歌Labs推出的Mixboard工具通过集成自研Nano Banana Pro图像模型，实现了从灵感到专业演示的高效转化，为创意生产提供了全新的解决方案。\u003c/p\u003e\u003cp\u003e\u003cvideo id=\"tmpVedio0\" class=\"edui-upload-video video-js vjs-default-skin video-js\" controls=\"\" preload=\"meta\" width=\"750\" height=\"450\" src=\"https://upload.chinaz.com/video/2025/1209/6390089225595342554690735.mp4\" data-setup=\"{}\"\u003e\u003csource src=\"https://upload.chinaz.com/video/2025/1209/6390089225595342554690735.mp4\" type=\"video/mp4\"/\u003e\u003c/video\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🖼️集成自研Nano Banana Pro图像模型，支持自定义提示词、框选导入、涂鸦编辑\u003c/p\u003e\u003cp\u003e🔄升级核心为Nano Banana Pro驱动，实现PPT一键生成和快速迭代\u003c/p\u003e\u003cp\u003e🌐开放与社区：公测限美国用户，Discord社群活跃，未来将开放API\u003c/p\u003e\u003cp\u003e详情链接:https://labs.google.com/mixboard/welcome\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e4、抖音副总裁李亮：AI 手机助手是机主授权的创新，与隐私无关\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e抖音副总裁李亮在采访中表示，AI 手机助手的所有操作均是基于机主的明确授权，而不是黑客行为或隐私侵害。他指出，这种技术在理论上已经成熟，但在实际应用中仍面临诸多挑战。同时，多个主流应用因安全考虑，禁止“豆包手机”登录。\u003c/p\u003e\u003cp style=\"text-align:center\"\u003e\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://upload.chinaz.com/2025/1209/6390086759143380846230401.png\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e📱 AI 手机助手基于用户授权，强调与隐私无关。\u003c/p\u003e\u003cp\u003e🚫 多个主流 App 因安全考虑，禁止 “豆包手机” 登录。\u003c/p\u003e\u003cp\u003e🔍 技已成熟，但实际应用仍面临多重挑战。\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e5、「设计→流片」1个月搞定！上海交大发布全球首个光子芯片垂直大模型 LightSeek，研发效率提升7倍\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e上海交通大学无锡光子芯片研究院（CHIPX）发布全球首个面向光子芯片全链路的专业大模型LightSeek，基于千亿级参数多模态架构，融合真实工艺数据，将设计-仿真-流片-测试周期从传统6-8个月压缩至1个月，整体研发效率提升7倍。\u003c/p\u003e\u003cp style=\"text-align:center\"\u003e\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://upload.chinaz.com/2025/1209/6390087002266610893779153.png\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🧪 专业底座：110nm中试线+几十万组真实数据\u003c/p\u003e\u003cp\u003e🚀 核心功能：全链路智能助手，提升研发效率7倍\u003c/p\u003e\u003cp\u003e🌐 开放策略：模型、接口、设备全链路开源\u003c/p\u003e\u003cp\u003e详情链接:https://lightseek.chipx.org/\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e6、谷歌推出 Doppl 购物发现功能，让虚拟试穿更轻松\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e谷歌在实验性应用 Doppl 中推出全新的购物发现功能，利用人工智能技术生成视频，展示真实产品，并根据用户的个人风格进行服装推荐。该功能旨在通过个性化推荐，帮助用户发现并虚拟试穿各种时尚单品。Doppl 的购物发现功能主要由人工智能生成的内容组成，而不是由现实生活中的网红进行推广。这一新功能已经在美国的 iOS 和 Android 平台上线，面向18岁及以上的用户开放。\u003c/p\u003e\u003cp style=\"text-align:center\"\u003e\u003c/p\u003e\u003cp style=\"text-align:center\" class=\"article-content__img\"\u003e\u003cstrong\u003e\u003cimg src=\"https://upload.chinaz.com/2025/1209/6390087117528141909604488.png\" alt=\"image.png\"/\u003e\u003c/strong\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🌟 新增购物发现功能，帮助用户个性化推荐和虚拟试穿时尚单品。\u003c/p\u003e\u003cp\u003e🛍️ 使用 AI 技术生成产品视频，提供更直观的购物体验。\u003c/p\u003e\u003cp\u003e📱 Doppl 功能已在美国上线，适用于18岁及以上用户。\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e7、智谱重磅开源 AutoGLM:能点外卖、订机票的手机级 AI Agent 向所有人开放\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e智谱开源 AutoGLM，这一具备“Phone Use”能力的 AI Agent 可以完成复杂的手机操作任务，如外卖点单和机票预订。其开源特性降低了 AI 手机的技术门槛，推动了 AI 生态从封闭走向开放，并为厂商和开发者提供了可复现、可修改、可扩展的能力底座。\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e📱 AutoGLM 能够稳定完成外卖点单、机票预订等复杂手机操作流程。\u003c/p\u003e\u003cp\u003e🌐 开源后，任何厂商和开发者都可以复现 AI 助手，实现“看懂屏幕”并完成点击、输入等操作。\u003c/p\u003e\u003cp\u003e🔒 支持本地与云端部署，保障用户数据与隐私安全。\u003c/p\u003e\u003c/blockquote\u003e\u003cp\u003e\u003cstrong\u003e8、OpenAI与德国电信达成合作，将部署ChatGPT企业版\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eOpenAI与德国电信达成合作，将部署ChatGPT企业版以提升内部工作流和客户服务效率。企业版ChatGPT确保数据安全与隐私保护，满足大型企业的合规和可靠性要求。生成式AI正在成为欧洲电信行业的重要基础技术之一，未来应用场景或将持续拓展。\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e【AiBase提要:】\u003c/p\u003e\u003cp\u003e🤝 OpenAI与德国电信达成合作，部署ChatGPT企业版以提升内部工作流和客户服务效率。\u003c/p\u003e\u003cp\u003e🔒 企业版ChatGPT确保数据安全与隐私保护，满足大型企业的合规和可靠性要求。\u003c/p\u003e\u003cp\u003e📈 生成式AI成为欧洲电信行业的重要基础技术，未来应用场景将不断拓展。\u003c/p\u003e\u003c/blockquote\u003e"])</script><script>self.__next_f.push([1,"23:T820,"])</script><script>self.__next_f.push([1,"\u003cp\u003eOpenAI宣布与欧洲\u003cspan class=\"spamTxt\"\u003e最大\u003c/span\u003e电信运营商之一德国电信（Deutsche Telekom）达成多年战略合作:自2026年起，后者将在全公司范围内部署ChatGPT Enterprise，并共同开发面向网络运维、客户服务与员工助手的AI解决方案。\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e合作要点\u0026nbsp;\u003c/strong\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e- 部署规模:德国电信约20万名员工将分批使用ChatGPT Enterprise，涵盖客服、IT运维、财务与人力资源等核心流程\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e- 技术落地:双方计划在德国本土数据中心托管专用计算集群，确保数据留在欧盟境内，满足GDPR合规要求\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e- 联合创新:除“开箱即用”的Enterprise版，双还将共同开发「电信行业模型」——利用德国电信全球网络日志、故障工单与客服录音，训练专属大模型，用于故障预测、基站配置优化与一线员工知识问答\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e商业模型\u003c/strong\u003e\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e- B2B 复制:德国电信将向欧洲企业客户转售「托管版ChatGPT」，搭配专线、边缘计算与5G切片，形成“网络+AI”捆绑方案\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e- 收入分成:OpenAI保留模型授权费，德国电信收取托管与集成服务费，目标2027年新增AI收入10亿欧元\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e战略背景\u003c/strong\u003e\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e- 用户基础:德国是ChatGPT付费用户最多的欧洲市场，也是OpenAI全球前三的商业客户来源国\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e- 算力基建:德国电信与英伟达10亿欧元「工业AI云」将于2026Q1上线，为本次合作提供GPU/网络/安全一体化底座\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e- 监管友好:本土数据中心+欧洲数据不出境，为欧盟企业采购生成式AI扫清合规障碍\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e下一步\u0026nbsp;\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e2025H2，双方将推出「电信行业模型」Beta，首批试点德国与奥地利企业客户;2026Q1随工业AI云正式商用，计划向法国、意大利等欧盟邻国复制托管模式。AIbase将持续跟踪其行业大模型性能、定价细节与合规认证进展。\u003c/p\u003e"])</script><script>self.__next_f.push([1,"7:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-white text-left\",\"children\":[[\"$\",\"$L1c\",null,{}],[\"$\",\"main\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"container mx-auto px-4 md:py-20 pt-20 pb-10\",\"children\":[\"$\",\"article\",null,{\"className\":\"md:pb-20 pb-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-[728px] tracking-wider mb-6 mx-auto flex flex-col flex-1\",\"children\":[\"$L1d\",[\"$\",\"$L1e\",null,{}],[\"$\",\"$L1f\",null,{\"article\":{\"Id\":23481,\"title\":\"智谱重磅开源 AutoGLM:能点外卖、订机票的手机级 AI Agent 向所有人开放\",\"subtitle\":\"智谱重磅开源 AutoGLM:能点外卖、订机票的手机级 AI Agent 向所有人开放\",\"description\":\"智谱开源AI Agent模型AutoGLM，该模型具备“Phone Use”能力，可稳定完成外卖点单、机票预订等长达数十步的复杂手机操作。开源后，硬件厂商、手机厂商及开发者可在自有系统中复现能“看懂屏幕”、像真人一样完成点击、输入、滑动等操作的AI助手。目前AutoGLM已支持微信、淘宝、抖音等超过50款高频中文应用。\",\"thumb\":\"https://pic.chinaz.com/picmap/202011131621513213_3.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e智谱今日宣布正式开源其核心 AI Agent 模型 \u003c/span\u003e\u003cstrong style=\\\"text-indent: 2em;\\\"\u003eAutoGLM\u003c/strong\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e，这一具备“Phone Use”能力的智能体能够稳定完成外卖点单、机票预订等长达数十步的复杂手机操作流程。开源意味着任何硬件厂商、手机厂商及开发者，都可以在自己的系统中复现一个能“看懂屏幕”、并能像真人一样完成点击、输入、滑动等操作的 AI 助手。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cimg src=\\\"https://pic.chinaz.com/picmap/202011131621513213_3.jpg\\\" title=\\\"玩手机，移动互联网 (图片来源图虫：已授站长之家使用)\\\" alt=\\\"玩手机，移动互联网\\\"/\u003e\u003c/p\u003e\u003cp\u003eAutoGLM 已支持包括微信、淘宝、抖音在内的超过50款高频中文应用的核心场景，其演示效果与此前引发行业关注的“豆包手机”极为相似:用户无需手动操作，只需让 AI 观察屏幕内容，它便可以自动执行任务、连续完成多步骤操作并直达结果。与其他智能体方案相比，AutoGLM 的优势在于稳定性与复杂流程处理能力，尤其适合在真实手机环境中执行长链条任务。\u003c/p\u003e\u003cp\u003e这一开源动作将显著降低 AI 手机的技术门槛，让“AI 能替你操作手机”不再是头部厂商的专属技术，而成为行业共同可构建的能力，推动 AI 手机生态从封闭走向开放，促使更多设备具备系统级智能体体验。AutoGLM 同时支持本地与云端部署，为厂商保留\u003cspan class=\\\"spamTxt\\\"\u003e最大\u003c/span\u003e化的数据与隐私控制权，也意味着用户未来有机会在无需上传隐私数据的前提下获得同等的智能体验。\u003c/p\u003e\u003cp\u003e对于正试图打造下一代系统级 AI 的手机厂商而言，AutoGLM 的开源无疑是一项战略级补全;对于开发者，它则提供了一个可复现、可修改、可扩展的完整智能体能力底座。随着更多厂商加入生态，这类具备真实交互能力的 AI Agent 可能会加速成为未来手机的标配能力。\u003c/p\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"AutoGLM\\\",\\\"智能体\\\",\\\"品牌产品词\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":45,\"addtime\":\"2025-12-09T09:14:24.5623548+08:00\",\"upded\":45,\"updtime\":\"2025-12-09T09:14:24.5623551+08:00\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":90,\"isailog\":1,\"sites\":\"\",\"categrates\":\"\",\"pv\":47}}]]}]}]}],[\"$\",\"$12\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"mt-8 py-4 text-center text-gray-500\",\"children\":\"loading...\"}],\"children\":[\"$\",\"div\",null,{\"className\":\"bg-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"container mx-auto px-4 md:py-20 py-8\",\"children\":[\"$\",\"$L20\",null,{\"articles\":[{\"Id\":23516,\"title\":\"美国电网危机：AI 产业的未来悬于电力供给之上！\",\"subtitle\":\"美国电网危机：AI 产业的未来悬于电力供给之上！\",\"description\":\"《金融时报》分析指出，美国电网因AI数据中心电力需求激增而面临巨大压力。预计到2028年，AI数据中心将新增约44吉瓦电力需求，但受限于电网基础设施瓶颈，仅能满足25吉瓦，导致约19吉瓦（占40%）的电力缺口，引发行业担忧。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202104261646199412_0.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e根据《金融时报》\u003cspan class=\\\"spamTxt\\\"\u003e最新\u003c/span\u003e分析，随着科技巨头在数据中心的投资不断飙升，美国电网面临前所未有的压力。预计到 2028 年，人工智能（AI）数据中心将新增约 44 吉瓦（GW）的电力需求。然而，由于电网基础设施的瓶颈，预计只有 25 吉瓦的新增电力能够满足这一需求，造成约 19 吉瓦的电力缺口，占总需求的 40%。这一现状让业内人士深感担忧，尤其是那些依赖于大量计算能力的企业。\u003c/p\u003e\u003cp\u003e主要的科技企业，如亚马逊、谷歌、Meta 和微软，已经计划投资超过 4000 亿美元，专门用于建设数据中心。尤其值得注意的是，OpenAI 与合作伙伴签署了高达 1.4 万亿美元的基础设施合同，以确保在未来八年内获取约 28 吉瓦的电力。OpenAI 首席执行官 Sam Altman 甚至称这种电力短缺为 “生死存亡的威胁”，因为没有足够的计算能力，公司将无法在必要的规模上盈利或开发新的模型。\u003c/p\u003e\u003cp\u003e此外，老旧的电网基础设施也加剧了这一问题。许多电线杆和变压器的使用年限甚至可以追溯到上世纪 60 年代和 70 年代，而冗长的行政审批流程使得从申请电网连接到实际商业运营的平均等待时间超过了八年。这种情况导致许多开发商为了提高竞争力，通过向不同的公用事业公司提交多个申请，进一步加剧了排队等候的现象。\u003c/p\u003e\u003cp\u003e面对电力供应问题，越来越多的 AI 公司开始探索 “门后发电” 的解决方案。例如，Elon Musk 的 xAI 公司在田纳西州的 “Colossus” 项目中，采用了未经环保许可的天然气涡轮发电机。OpenAI 也在德克萨斯州的 “Stargate” 项目中计划使用十台天然气涡轮机，而微软则希望通过重启 “三哩岛” 核电站来寻求电力支持。\u003c/p\u003e\u003cp\u003e随着美国科技行业对电力的渴求愈发强烈，OpenAI 甚至向美国政府发出警告，指出中国在基础设施建设上已经逐渐领先。2024 年，中国的新增电力容量达到 429 吉瓦，几乎是美国电网总容量的三分之一，而美国同期仅新增 51 吉瓦电力。环保人士警告，若电力短缺问题得不到解决，AI 行业可能面临泡沫破裂的风险。\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\",\"tags\":\"[\\\"AI数据中心\\\",\\\"电力缺口\\\",\\\"OpenAI\\\",\\\"电网基础设施\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2025-12-09 18:00:50\",\"upded\":1575334,\"updtime\":\"2025-12-09 18:00:50\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":18},{\"Id\":23515,\"title\":\"全球首个原生多模态架构 NEO 横空出世，视觉与语言完美融合\",\"subtitle\":\"全球首个原生多模态架构 NEO 横空出世，视觉与语言完美融合\",\"description\":\"AI专家Ilya Sutskever指出，单纯扩大模型规模的时代已结束，未来突破将依赖更智能的架构设计。这标志着AI发展从“唯规模论”转向新路径。在此背景下，中国团队推出了开源原生多模态架构NEO，为领域创新提供新方向。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202305091556144476_5.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e在人工智能领域的\u003cspan class=\\\"spamTxt\\\"\u003e最新\u003c/span\u003e动态中，Ilya Sutskever 的\u003cspan class=\\\"spamTxt\\\"\u003e最新\u003c/span\u003e声明掀起了一场巨变。他表示，单靠扩大模型规模的时代已经结束，未来的突破将来自于更智能的架构设计。对此，整个 AI 界都感受到了深刻的转变，因为过往几年的发展路径似乎陷入了数据与参数的 “唯规模论”，然而这一方式正面临逐渐减弱的收益。\u003c/p\u003e\u003cp\u003e在这一背景下，由中国研究团队打造的开源原生多模态架构 NEO 应运而生。与之前主流的多模态模型，如 GPT-4V 和 Claude 3.5 等的拼接方式不同，NEO 从根本上重新定义了视觉与语言的关系。传统的多模态模型通常将视觉编码器与语言模型分开，二者在数据层面粗暴地拼接在一起，导致信息传递不够顺畅。而 NEO 则通过创建一个统一的模型，使视觉与语言从一开始就紧密结合，犹如两者血脉相连。\u003c/p\u003e\u003cp\u003eNEO 的核心创新在于三大技术突破。首先，它引入了原生图块嵌入技术，允许 AI 直接从像素开始构建高保真的视觉表征，提升了图像细节的捕捉能力。其次，NEO 开发了原生三维旋转位置编码，利用高频和低频的不同组合，准确地处理图像和文本中的位置关系，形成一个智能的时空坐标系。最后，原生多头注意力机制使得视觉与语言的信息可以在同一个框架下进行交流，极大增强了模型对复杂语义的理解能力。\u003c/p\u003e\u003cp\u003e令人惊讶的是，NEO 在仅用传统模型十分之一的训练数据的情况下，便在多项评测中追平甚至超越了许多旗舰级对手。这一成果不仅证明了原生架构的有效性，也标志着 AI 模型发展的新方向。\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"NEO\\\",\\\"多模态架构\\\",\\\"原生图块嵌入\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2025-12-09 17:23:38\",\"upded\":1575334,\"updtime\":\"2025-12-09 17:23:52\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":17},{\"Id\":23514,\"title\":\"阿里通义千问推出最新版Qwen Code v0.3.0！双语界面助力开发者提升效率\",\"subtitle\":\"阿里通义千问推出最新版Qwen Code v0.3.0\",\"description\":\"阿里通义千问推出Qwen Code v0.3.0，专为Qwen3-Coder模型优化，旨在提升开发者效率。该工具具备强大的代码理解与自动化任务能力，并新增智能辅助功能。此次更新重点围绕功能扩展、国际化支持、安全性和生态适配四个方面，例如新增Stream JSON模式，以增强开发体验。\",\"thumb\":\"https://upload.chinaz.com/2025/1209/6390089550748636842208553.png\",\"classname\":\"\",\"summary\":\"\u003cp\u003e阿里通义千问正式推出了其\u003cspan class=\\\"spamTxt\\\"\u003e最新\u003c/span\u003e版本的 Qwen Code v0.3.0，旨在进一步提升开发者的专业能力。这款专为 Qwen3-Coder 模型优化的命令行 AI 工作流工具，不仅具备强大的代码理解能力和自动化任务功能，还融入了智能辅助功能，让开发者在编程的过程中更加高效。\u003c/p\u003e\u003cp\u003e此次更新围绕功能扩展、国际化支持、安全性和生态适配四个方面进行了全面升级。首先，新增的 Stream JSON 模式，使得开发者在自动化和 CI/CD 流程中能享受到更流畅的体验。该模式支持流式、结构化输出，简化了复杂任务的输入过程，同时引入了三层 Adapter 架构和完整的 Session 管理，极大提升了灵活性和集成性。\u003c/p\u003e\u003cp style=\\\"text-align:center\\\"\u003e\u003cimg src=\\\"https://upload.chinaz.com/2025/1209/6390089550748636842208553.png\\\" title=\\\"image.png\\\" alt=\\\"image.png\\\"/\u003e\u003c/p\u003e\u003cp\u003e其次，国际化能力的提升意味着更多全球开发者将能够轻松使用 Qwen Code。现在，工具内置了中英文界面，用户只需一键即可切换语言。此外，用户还能设置模型的输出语言，并加载自定义语言包，推动全球社区的共同发展。\u003c/p\u003e\u003cp\u003e在安全与稳定性方面，本次版本同样进行了一系列强化。通过升级内存安全机制，Qwen Code 引入了20MB 的安全缓冲限制，有效减少了可能的内存泄露风险。同时，Windows 编码问题得到了修复，确保跨平台的兼容性大幅提升。此外，CI/CD 测试链路的加强，也让整体的开发体验更加稳定。\u003c/p\u003e\u003cp\u003e最后，生态适配方面的增强，使得 Qwen Code 在多项生态能力上得到了补充，支持 ModelScope Provider，优化了 stream_options 的处理，修复了多项核心逻辑问题，为用户提供了更完善的开发环境。\u003c/p\u003e\u003cp\u003e通过这次重磅更新，阿里通义千问的 Qwen Code 无疑将为开发者们提供更加强大的工具，助力他们在技术创新的道路上不断前行。\u003c/p\u003e\",\"tags\":\"[\\\"QwenCode\\\",\\\"AI新词\\\",\\\"阿里通义千问\\\",\\\"Codev0.3.0\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2025-12-09 16:46:15\",\"upded\":1575334,\"updtime\":\"2025-12-09 16:46:15\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":90,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":27},{\"Id\":23513,\"title\":\"​努比亚总裁倪飞：AI 手机是未来发展方向，与豆包手机合作提升用户体验\",\"subtitle\":\"​努比亚总裁：AI 手机是未来发展方向，与豆包手机合作提升用户体验\",\"description\":\"努比亚总裁倪飞表示，AI手机是行业未来趋势。公司近期推出与豆包手机助手合作的预览版，旨在提升用户体验。倪飞回顾了努比亚自2017年以来的AI布局，强调开放合作应对行业创新瓶颈。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202011131621513213_3.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e努比亚总裁倪飞就近期推出的 “努比亚 M153豆包手机助手技术预览版” 发表了重要讲话，回应了外界对该产品的广泛关注。倪飞表示，当前手机行业面临着创新乏力的局面，而人工智能（AI）手机将成为未来发展的重要趋势。在这一背景下，努比亚选择与豆包手机助手开展开放合作，以提升用户的使用体验。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e倪飞回顾了努比亚自2017年以来在 AI 领域的布局，强调公司始终秉持 “AI for All” 的理念，致力于让 AI 技术惠及更多用户。自推出\u003cspan class=\\\"spamTxt\\\"\u003e首款\u003c/span\u003e AI 手机 Z17以来，努比亚不断推进技术创新与应用，展现了其在多模型协同方面的前瞻性思维。\u003cspan class=\\\"spamTxt\\\"\u003e最新\u003c/span\u003e的 M153手机与豆包助手的合作，正是公司在 AI 技术持续创新与全场景应用方面的重要里程碑。\u003c/p\u003e\u003cp\u003e在谈及用户反馈时，倪飞指出，努比亚与合作伙伴正在积极沟通，努力解决用户在使用过程中遇到的问题。他表示，努比亚未来将继续专注于提升用户体验，并与行业各方及用户共同推动 “AI for All” 的进程，为消费者提供更智能、更便捷的手机体验。\u003c/p\u003e\u003cp style=\\\"text-align:center\\\"\u003e\u003cimg src=\\\"https://pic.chinaz.com/2025/1209/2025120916342931390.jpg\\\"/\u003e\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e划重点:\u003c/p\u003e\u003cp\u003e🌟 AI 手机将是未来发展的重要趋势，努比亚正积极布局。\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e🤝 努比亚与豆包手机助手的合作旨在提升用户体验。\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e🔧 公司将继续解决用户反馈的问题，致力于技术创新。\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003c/blockquote\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"努比亚M153\\\",\\\"豆包手机助手\\\",\\\"AIforAll\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1597147,\"addtime\":\"2025-12-09 16:34:29\",\"upded\":1597147,\"updtime\":\"2025-12-09 16:34:29\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":23},{\"Id\":23512,\"title\":\"美国电网老化威胁 OpenAI 与微软扩张计划  ​\",\"subtitle\":\"美国电网老化威胁 OpenAI 与微软扩张计划  ​\",\"description\":\"《金融时报》分析显示，美国电网因科技巨头数据中心投资激增而承压。预计到2028年，AI数据中心新增电力需求达44吉瓦，但电网瓶颈仅能供应约25吉瓦，导致近19吉瓦缺口，占总需求40%。亚马逊、谷歌等超大规模企业面临电力供应挑战。\",\"thumb\":\"https://pic.chinaz.com/picmap/202302150929449091_0.jpg\",\"classname\":\"\",\"summary\":\"$21\",\"tags\":\"[\\\"AI数据中心\\\",\\\"电网压力\\\",\\\"超大规模企业\\\",\\\"OpenAI\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1597147,\"addtime\":\"2025-12-09 16:19:31\",\"upded\":1597147,\"updtime\":\"2025-12-09 16:19:31\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":17},{\"Id\":23511,\"title\":\"AI日报：蚂蚁推灵光网页版AI助手；智谱开源GLM-4.6V系列；谷歌Mixboard重磅升级\",\"subtitle\":\"AI日报：蚂蚁推灵光网页版AI助手；智谱开源GLM-4.6V系列\",\"description\":\"欢迎来到【AI日报】栏目!这里是你每天探索人工智能世界的指南，每天我们为你呈现AI领域的热点内容，聚焦开发者，助你洞悉技术趋势、了解创新AI产品应用。新鲜AI产品点击了解：https://app.aibase.com/zh1、智谱开源GLM-4.6V系列：106B原生支持FunctionCall，轻量版9B免费商用智谱开源GLM-4.6V系列模型，具备强大的多模态处理能力和原生FunctionCall功能，同时提供免费的轻量版和价格优惠的基础版，适合多种应用场景。生成式AI正在成为欧洲电信行业的重要基础技术之一，未来应用场景或将持续拓展。\",\"thumb\":\"https://pic.chinaz.com/picmap/202406051435016830_1.jpg\",\"classname\":\"\",\"summary\":\"$22\",\"tags\":\"[\\\"AI日报\\\",\\\"GLM-4.6V\\\",\\\"FunctionCall\\\",\\\"智谱\\\"]\",\"sourcename\":\"站长之家\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":6,\"added\":1575334,\"addtime\":\"2025-12-09 15:49:35\",\"upded\":1575334,\"updtime\":\"2025-12-09 15:51:15\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":100,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":2},{\"Id\":23510,\"title\":\"MIT 推出新方法，显著提升大型语言模型计算效率\",\"subtitle\":\"MIT 推出新方法，显著提升大型语言模型计算效率\",\"description\":\"MIT研究团队开发出实例自适应缩放技术，可根据问题复杂度动态调整大型语言模型的计算资源，提升效率并降低能耗。该研究获多家机构支持，相关论文已于11月初发布。\",\"thumb\":\"https://pic.chinaz.com/picmap/202310270933190076_7.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003eMIT 的研究团队近日发布了一项创新的计算方法，旨在提高大型语言模型（LLM）的运算效率，同时降低能源消耗。这项名为实例自适应缩放的技术，可以根据提问的复杂程度调整计算资源。研究小组的相关论文于11月初发布，得到了 MIT-IBM 沃森人工智能实验室、MIT-Amazon 科学中心、MIT-Google 计算创新项目以及 MathWorks 的支持。\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cimg src=\\\"https://pic.chinaz.com/picmap/202310270933190076_7.jpg\\\"/\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center;\\\"\u003e图源备注：图片由AI生成，图片授权服务商Midjourney\u003c/p\u003e\u003cp\u003e传统的大型语言模型在处理问题时，往往会使用固定的推理过程奖励模型（PRMs），这使得它们在面对不同复杂度的问题时，计算资源利用率不高，且常常高估成功的概率。MIT 的研究人员通过重新设计 PRMs，使其能够根据不同的问题动态调整推理轨迹的数量。这样，简单的问题可以使用较少的计算资源，而复杂的问题则可以获得更多的推理支持。\u003c/p\u003e\u003cp\u003e研究人员指出，人的思维过程往往是通过分解复杂问题、逐步推理和不断修正来进行的，而 LLM 也同样能从这一过程中获益，能够在推理时获得更多的 “思考” 时间。研究显示，采用这种新方法后，计算资源的使用量减少了一半，同时依然能够提供与现有模型相媲美的准确回答。此外，经过重新校准的 PRMs 也为较小的 LLM 提升了性能。\u003c/p\u003e\u003cp\u003e鉴于这一技术的成功，MIT 团队表示他们将进一步探索该方法在其他应用中的表现，如代码生成和人工智能代理，并计划探索 PRM 校准方法在强化学习等领域的更多应用。\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e划重点:\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e💡 研究团队提出的实例自适应缩放技术可以根据问题复杂性动态调整 LLM 的计算资源。\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e🔍 通过重新设计的推理过程奖励模型，计算资源的利用效率大幅提高，简单问题减少计算，复杂问题获得更多支持。\u0026nbsp;\u0026nbsp;\u003c/p\u003e\u003cp\u003e⚙️ 研究成果显示，该方法能将计算量减半，同时保持相似的准确性，未来将探索其在其他领域的应用潜力。\u003c/p\u003e\u003c/blockquote\u003e\",\"tags\":\"[\\\"实例自适应缩放\\\",\\\"MIT\\\",\\\"大型语言模型\\\",\\\"AI生成\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1597147,\"addtime\":\"2025-12-09 15:40:30\",\"upded\":1597147,\"updtime\":\"2025-12-09 15:40:30\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":18},{\"Id\":23509,\"title\":\"OpenAI牵手欧洲电信巨头：2026年起向德国电信全线输出ChatGPT企业版，网络运维也要AI化\",\"subtitle\":\"OpenAI牵手欧洲电信巨头：2026年起向德国电信全线输出ChatGPT企业版\",\"description\":\"OpenAI与德国电信达成战略合作，自2026年起，德国电信将在全公司范围内部署ChatGPT Enterprise，覆盖约20万名员工，应用于客服、IT运维、财务与人力资源等核心流程。双方还计划在德国本土数据中心托管专用计算集群，共同开发面向网络运维、客户服务与员工助手的AI解决方案。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/202302150929449091_0.jpg\",\"classname\":\"\",\"summary\":\"$23\",\"tags\":\"[\\\"AI新词\\\",\\\"ChatGPTEnterprise\\\",\\\"德国电信\\\",\\\"人工智能解决方案\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2025-12-09 15:10:09\",\"upded\":1575334,\"updtime\":\"2025-12-09 15:10:09\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":60,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":6},{\"Id\":23508,\"title\":\"OpenAI与德国电信达成合作，将部署ChatGPT企业版\",\"subtitle\":\"OpenAI与德国电信达成合作，将部署ChatGPT企业版\",\"description\":\"OpenAI与德国电信达成合作，后者将全面采用ChatGPT企业版，以提升内部效率与客户服务质量。此举显示电信业正加速引入企业级生成式AI，推动数字化升级。OpenAI强调该版本可保障数据安全与隐私。\",\"thumb\":\"https://pic.chinaz.com/picmap/202502061723419905_1.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e\u0026nbsp;OpenAI宣布已与欧洲\u003cspan class=\\\"spamTxt\\\"\u003e最大\u003c/span\u003e电信运营商之一——德国电信（Deutsche Telekom）达成合作协议。根据协议，德国电信将全面采用 ChatGPT 企业版，用于提升内部工作流与面向客户的服务效率。\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cimg src=\\\"https://pic.chinaz.com/picmap/202502061723419905_1.jpg\\\" title=\\\"OpenAI (图片来源：AI合成)\\\" alt=\\\"OpenAI\\\"/\u003e\u003c/p\u003e\u003cp\u003e此次合作意味着大型电信运营商正在加速引入企业级生成式AI工具，以增强运营能力、提升客服响应质量并推动业务数字化升级。OpenAI方面表示，企业版ChatGPT可确保数据安全与隐私保护，满足大型企业在合规和可靠性上的严格要求。\u003c/p\u003e\u003cp\u003e这一合作也进一步显示，生成式AI正在成为欧洲电信行业的重要基础技术之一，未来应用场景或将持续拓展。\u003c/p\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"ChatGPT\\\",\\\"德国电信\\\",\\\"企业版\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1575334,\"addtime\":\"2025-12-09 14:35:33\",\"upded\":1575334,\"updtime\":\"2025-12-09 15:45:22\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":60,\"isailog\":1,\"sites\":\"\",\"categrates\":\"\",\"pv\":3},{\"Id\":23507,\"title\":\"谷歌 CEO：AI 将重塑职场，人人需适应新变革\",\"subtitle\":\"谷歌 CEO：AI 将重塑职场，人人需适应新变革\",\"description\":\"谷歌CEO皮查伊警告，AI将影响从低端到高管的所有工作，可能引发社会剧变。他强调AI潜力巨大，但需认真应对变革。谷歌新模型Gemini3获业界好评。\",\"thumb\":\"https://pic.chinaz.com/picmap/thumb/201811151642405924_24.jpg\",\"classname\":\"\",\"summary\":\"\u003cp\u003e在当前科技迅速发展的背景下，谷歌 CEO 桑达尔・皮查伊表示，人工智能（AI）不仅会影响低端工作，甚至连高管职位也将面临挑战。他指出，AI 是人类正在研发的最深远的技术，具备带来巨大好处的潜力，但同时也会导致社会的剧烈变革。皮查伊在接受 BBC 采访时提到，社会必须认真面对这场技术革命。\u003c/p\u003e\u003cp\u003e谷歌最近推出了其\u003cspan class=\\\"spamTxt\\\"\u003e最新\u003c/span\u003e的 AI 模型 Gemini3，该模型受到了广泛好评，业界对此充满了期待。皮查伊强调，随着技术的不断进步，虽然某些工作将会被淘汰，但也会创造出新的机会。他认为，未来的工作将会经历演变，职场中的某些角色将被取代，因此人们必须积极适应这一变化。\u003c/p\u003e\u003cp\u003e在谈到年轻专业人士的未来时，皮查伊指出，尽管当前就业市场不确定性加大，许多新兴职业和传统职业都将受到 AI 的影响，但年轻人不必因 AI 的崛起而怀疑自己的职业选择。他建议，年轻人在选择职业时应该追求自己的兴趣，而不是仅仅考虑职业的 “安全性”。他呼吁新一代要拥抱技术，学习如何将 AI 应用于自己的工作中。\u003c/p\u003e\u003cp\u003e然而，数据显示，自从 ChatGPT 发布以来，美国的招聘广告数量已减少约32%。一些传统高薪职业，如计算机编程的就业人数也出现了显著下滑。面对这些变化，许多年轻人开始重新思考高昂的大学学费是否值得，甚至考虑转向看似更 “抗 AI” 的蓝领工作。尽管如此，皮查伊仍然坚定地认为，选择未来职业时，大家不应过于担心 AI 的影响，而应该坚持自己的兴趣和热情。\u003c/p\u003e\u003cblockquote\u003e\u003cp\u003e划重点:\u003c/p\u003e\u003cp\u003e🌐 AI 正在重塑职场，连高管职位也将受到影响。\u003c/p\u003e\u003cp\u003e🔍 人们需要积极适应 AI 带来的变革，才能在职场上取得成功。\u003c/p\u003e\u003cp\u003e🎓 年轻人应追求自己的职业兴趣，而不是仅考虑职业的安全性。\u003c/p\u003e\u003c/blockquote\u003e\",\"tags\":\"[\\\"AI新词\\\",\\\"谷歌\\\",\\\"Gemini3\\\",\\\"ChatGPT\\\"]\",\"sourcename\":\"AIbase基地\",\"author\":\"\",\"status\":2,\"url\":\"\",\"type\":1,\"added\":1597147,\"addtime\":\"2025-12-09 14:31:15\",\"upded\":1597147,\"updtime\":\"2025-12-09 14:31:15\",\"isshoulu\":0,\"vurl\":\"\",\"vsize\":0,\"weight\":80,\"isailog\":0,\"sites\":\"\",\"categrates\":\"\",\"pv\":30}],\"flag\":\"zh\"}]}]}]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"24:I[42983,[\"6453\",\"static/chunks/6453-8d86949207f0d049.js\",\"6874\",\"static/chunks/6874-4d0275c9ddac042c.js\",\"6995\",\"static/chunks/6995-8c03d599553cd188.js\",\"3658\",\"static/chunks/3658-ce4d23d9f61b3d71.js\",\"570\",\"static/chunks/570-921e7c24d307cf67.js\",\"2099\",\"static/chunks/2099-2d4e810935ebf618.js\",\"1345\",\"static/chunks/1345-9cbdb7de935bb6f8.js\",\"6014\",\"static/chunks/6014-fd967af2cd377f19.js\",\"3479\",\"static/chunks/3479-160df37dc9d3af1b.js\",\"6396\",\"static/chunks/6396-6ba6bdcdfe66440a.js\",\"5978\",\"static/chunks/5978-53d10df9994c37c9.js\",\"5151\",\"static/chunks/5151-15e5c4a6b6125374.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-5050e0732c7f73f0.js\"],\"LocalizedLink\"]\n25:I[53062,[\"6453\",\"static/chunks/6453-8d86949207f0d049.js\",\"6874\",\"static/chunks/6874-4d0275c9ddac042c.js\",\"6995\",\"static/chunks/6995-8c03d599553cd188.js\",\"3658\",\"static/chunks/3658-ce4d23d9f61b3d71.js\",\"570\",\"static/chunks/570-921e7c24d307cf67.js\",\"2099\",\"static/chunks/2099-2d4e810935ebf618.js\",\"1345\",\"static/chunks/1345-9cbdb7de935bb6f8.js\",\"6014\",\"static/chunks/6014-fd967af2cd377f19.js\",\"3479\",\"static/chunks/3479-160df37dc9d3af1b.js\",\"6396\",\"static/chunks/6396-6ba6bdcdfe66440a.js\",\"5978\",\"static/chunks/5978-53d10df9994c37c9.js\",\"5151\",\"static/chunks/5151-15e5c4a6b6125374.js\",\"8139\",\"static/chunks/app/%5Blang%5D/news/%5Bid%5D/page-5050e0732c7f73f0.js\"],\"ArticleMeta\"]\n"])</script><script>self.__next_f.push([1,"1d:[\"$\",\"div\",null,{\"className\":\"px-4 flex flex-col mt-8 md:mt-16\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"md:text-4xl text-3xl leading-[42px] md:leading-[48px] font-extrabold text-[#242424]\",\"children\":\"智谱重磅开源 AutoGLM:能点外卖、订机票的手机级 AI Agent 向所有人开放\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center mt-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-10 h-10 rounded-full overflow-hidden mr-4 flex-shrink-0\",\"children\":[\"$\",\"img\",null,{\"className\":\"object-cover h-full w-full\",\"src\":\"https://app.aibase.com/icon/logo.png\",\"alt\":\"aibase\",\"width\":40,\"height\":40}]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"text-surface-600\",\"children\":\"AIbase基地\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center flex-wrap text-sm text-surface-500\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-1\",\"children\":\"发布于\"}],[\"$\",\"$L24\",null,{\"href\":\"/news/\",\"className\":\"text-surface-700\",\"children\":\"AI新闻资讯\"}],[\"$\",\"span\",null,{\"className\":\"mx-2 inline-block\",\"children\":\" · \"}],[\"$\",\"span\",null,{\"children\":[1,\" \",\"分钟阅读\"]}],[\"$\",\"span\",null,{\"className\":\"mx-2 inline-block\",\"children\":\" · \"}],[\"$\",\"span\",null,{\"children\":\"Dec 9, 2025\"}]]}]]}]]}],[\"$\",\"$L25\",null,{\"article\":\"$7:props:children:1:props:children:0:props:children:props:children:props:children:2:props:article\"}],[\"$\",\"div\",null,{\"className\":\"leading-8 text-[#242424] post-content md:mt-12 mt-8 text-lg space-y-7 text-wrap break-words overflow-hidden\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e智谱今日宣布正式开源其核心 AI Agent 模型 \u003c/span\u003e\u003cstrong style=\\\"text-indent: 2em;\\\"\u003eAutoGLM\u003c/strong\u003e\u003cspan style=\\\"text-indent: 2em;\\\"\u003e，这一具备“Phone Use”能力的智能体能够稳定完成外卖点单、机票预订等长达数十步的复杂手机操作流程。开源意味着任何硬件厂商、手机厂商及开发者，都可以在自己的系统中复现一个能“看懂屏幕”、并能像真人一样完成点击、输入、滑动等操作的 AI 助手。\u003c/span\u003e\u003c/p\u003e\u003cp style=\\\"text-align: center\\\"\u003e\u003cimg src=\\\"https://pic.chinaz.com/picmap/202011131621513213_3.jpg\\\" title=\\\"玩手机，移动互联网 (图片来源图虫：已授站长之家使用)\\\" alt=\\\"玩手机，移动互联网\\\"/\u003e\u003c/p\u003e\u003cp\u003eAutoGLM 已支持包括微信、淘宝、抖音在内的超过50款高频中文应用的核心场景，其演示效果与此前引发行业关注的“豆包手机”极为相似:用户无需手动操作，只需让 AI 观察屏幕内容，它便可以自动执行任务、连续完成多步骤操作并直达结果。与其他智能体方案相比，AutoGLM 的优势在于稳定性与复杂流程处理能力，尤其适合在真实手机环境中执行长链条任务。\u003c/p\u003e\u003cp\u003e这一开源动作将显著降低 AI 手机的技术门槛，让“AI 能替你操作手机”不再是头部厂商的专属技术，而成为行业共同可构建的能力，推动 AI 手机生态从封闭走向开放，促使更多设备具备系统级智能体体验。AutoGLM 同时支持本地与云端部署，为厂商保留\u003cspan class=\\\"spamTxt\\\"\u003e最大\u003c/span\u003e化的数据与隐私控制权，也意味着用户未来有机会在无需上传隐私数据的前提下获得同等的智能体验。\u003c/p\u003e\u003cp\u003e对于正试图打造下一代系统级 AI 的手机厂商而言，AutoGLM 的开源无疑是一项战略级补全;对于开发者，它则提供了一个可复现、可修改、可扩展的完整智能体能力底座。随着更多厂商加入生态，这类具备真实交互能力的 AI Agent 可能会加速成为未来手机的标配能力。\u003c/p\u003e\"},\"style\":{\"wordBreak\":\"break-word\",\"overflowWrap\":\"break-word\",\"hyphens\":\"auto\"}}],[\"$\",\"div\",null,{\"className\":\"my-8 flex space-x-3 flex-wrap\",\"children\":[[\"$\",\"$L24\",\"AI新词\",{\"href\":\"/search/AI新词\u0026type=0\",\"className\":\"tag-badge mb-4 cursor-pointer text-sm hover:bg-slate-200 bg-slate-100 text-slate-800 rounded inline-block py-1 px-2\",\"children\":\"AI新词\"}],[\"$\",\"$L24\",\"AutoGLM\",{\"href\":\"/search/AutoGLM\u0026type=0\",\"className\":\"tag-badge mb-4 cursor-pointer text-sm hover:bg-slate-200 bg-slate-100 text-slate-800 rounded inline-block py-1 px-2\",\"children\":\"AutoGLM\"}],[\"$\",\"$L24\",\"智能体\",{\"href\":\"/search/智能体\u0026type=0\",\"className\":\"tag-badge mb-4 cursor-pointer text-sm hover:bg-slate-200 bg-slate-100 text-slate-800 rounded inline-block py-1 px-2\",\"children\":\"智能体\"}],[\"$\",\"$L24\",\"品牌产品词\",{\"href\":\"/search/品牌产品词\u0026type=0\",\"className\":\"tag-badge mb-4 cursor-pointer text-sm hover:bg-slate-200 bg-slate-100 text-slate-800 rounded inline-block py-1 px-2\",\"children\":\"品牌产品词\"}]]}]]}]\n"])</script></body></html>