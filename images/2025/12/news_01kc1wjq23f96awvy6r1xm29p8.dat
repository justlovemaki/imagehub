uIcon\":\"icon-daima\",\"menuType\":2,\"sort\":2,\"status\":1,\"children\":[]}]}]},{\"menuName\":\"AI服务\",\"menuOtherName\":null,\"menuDescription\":null,\"menuUrl\":\"\",\"menuIcon\":\"\",\"menuType\":1,\"sort\":6,\"status\":1,\"children\":[{\"menuName\":\"工具\",\"menuOtherName\":null,\"menuDescription\":null,\"menuUrl\":\"\",\"menuIcon\":\"\",\"menuType\":1,\"sort\":1,\"status\":1,\"children\":[{\"menuName\":\"GEO品牌监控分析\",\"menuOtherName\":null,\"menuDescription\":\"分析并追踪人工智能模型如何引用您的品牌\",\"menuUrl\":\"//app.aibase.com/tools/trackers\",\"menuIcon\":\"icon-wendangshibie\",\"menuType\":2,\"sort\":1,\"status\":1,\"children\":[]},{\"menuName\":\"GEO排名查询工具\",\"menuOtherName\":null,\"menuDescription\":\"检测品牌在AI平台中的可见度\",\"menuUrl\":\"//app.aibase.com/tools/geo\",\"menuIcon\":\"icon-shuju\",\"menuType\":2,\"sort\":2,\"status\":1,\"children\":[]}]},{\"menuName\":\"服务\",\"menuOtherName\":null,\"menuDescription\":null,\"menuUrl\":\"\",\"menuIcon\":\"\",\"menuType\":1,\"sort\":1,\"status\":1,\"children\":[{\"menuName\":\"GEO 大模型推荐优化\",\"menuOtherName\":null,\"menuDescription\":\"通过AI搜索优化服务，让品牌在AI中实现霸屏\",\"menuUrl\":\"//app.aibase.com/geo\",\"menuIcon\":\"icon-GEO\",\"menuType\":2,\"sort\":1,\"status\":1,\"children\":[]}]}]},{\"menuName\":\"算力市场\",\"menuOtherName\":null,\"menuDescription\":null,\"menuUrl\":\"\",\"menuIcon\":\"\",\"menuType\":1,\"sort\":7,\"status\":1,\"children\":[{\"menuName\":\"工具\",\"menuOtherName\":null,\"menuDescription\":null,\"menuUrl\":\"\",\"menuIcon\":\"\",\"menuType\":1,\"sort\":2,\"status\":1,\"children\":[{\"menuName\":\"模型个人电脑配置检测器\",\"menuOtherName\":null,\"menuDescription\":\"一键检测电脑配置，研判运行模型的兼容性\",\"menuUrl\":\"//model.aibase.com/tools/pc-check\",\"menuIcon\":\"icon-diannaojiance\",\"menuType\":2,\"sort\":1,\"status\":1,\"children\":[]},{\"menuName\":\"模型部署服务器配置计算器\",\"menuOtherName\":null,\"menuDescription\":\"根据算力需求，推荐匹配的服务器配置\",\"menuUrl\":\"//model.aibase.com/tools/server-config-calculator\",\"menuIcon\":\"icon-jisuanqi\",\"menuType\":2,\"sort\":2,\"status\":1,\"children\":[]}]}]},{\"menuName\":\"AI应用指南\",\"menuOtherName\":null,\"menuDescription\":null,\"menuUrl\":\"//course.aibase.com\",\"menuIcon\":\"\",\"menuType\":1,\"sort\":8,\"status\":1,\"children\":[]}],\"currentLanguage\":{\"code\":\"zh\",\"name\":\"中文\",\"flag\":\"🇨🇳\",\"apiKey\":\"zh_cn\"}},\"children\":[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"$L1b\",null,{}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}]\n"])</script><script>self.__next_f.push([1,"14:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"智谱重磅开源 AutoGLM:能点外卖、订机票的手机级 AI Agent 向所有人开放\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"智谱今日宣布正式开源其核心 AI Agent 模型 AutoGLM，这一具备“Phone Use”能力的智能体能够稳定完成外卖点单、机票预订等长达数十步的复杂手机操作流程。开源意味着任何硬件厂商、手机厂商及开发者，都可以在自己的系统中复现一个能“看懂屏幕”、并能像真人一样完成点击、输入、滑动等操作的 AI 助手。Aut\"}],[\"$\",\"meta\",\"2\",{\"name\":\"robots\",\"content\":\"index\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"www.aibase.com/zh/news/23481\"}],[\"$\",\"link\",\"4\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"www.aibase.com/news/23481\"}],[\"$\",\"link\",\"5\",{\"rel\":\"alternate\",\"hrefLang\":\"in\",\"href\":\"www.aibase.com/in/news/23481\"}],[\"$\",\"link\",\"6\",{\"rel\":\"alternate\",\"hrefLang\":\"fr\",\"href\":\"www.aibase.com/fr/news/23481\"}],[\"$\",\"link\",\"7\",{\"rel\":\"alternate\",\"hrefLang\":\"es\",\"href\":\"www.aibase.com/es/news/23481\"}],[\"$\",\"link\",\"8\",{\"rel\":\"alternate\",\"hrefLang\":\"de\",\"href\":\"www.aibase.com/de/news/23481\"}],[\"$\",\"link\",\"9\",{\"rel\":\"alternate\",\"hrefLang\":\"pt\",\"href\":\"www.aibase.com/pt/news/23481\"}],[\"$\",\"link\",\"10\",{\"rel\":\"alternate\",\"hrefLang\":\"ja\",\"href\":\"www.aibase.com/ja/news/23481\"}],[\"$\",\"meta\",\